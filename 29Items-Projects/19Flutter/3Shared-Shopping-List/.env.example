# ==============================================================================
# Shared Shopping List - Environment Configuration Template
# Duplicate this file to .env.dev, .env.staging, or .env.prod
# DO NOT commit production secrets to public version control
# ==============================================================================

# Application Environment (dev | staging | prod)
APP_ENV=dev

# Firebase Configuration
FIREBASE_PROJECT_ID=shopping-list-dev
FIREBASE_API_KEY=AIzaSyA_exampleDevApiKey1234567890
FIREBASE_APP_ID_ANDROID=1:1234567890:android:abc123def456
FIREBASE_APP_ID_IOS=1:1234567890:ios:abc123def456
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_STORAGE_BUCKET=shopping-list-dev.appspot.com

# Dynamic Links / Universal Links Domain
DYNAMIC_LINK_DOMAIN=https://shoppinglist.page.link
APP_UNIVERSAL_LINK_HOST=shoppinglist.app

# Firebase App Distribution Tester Groups
FIREBASE_TESTER_GROUPS=internal-qa,household-beta

# Feature Flags
ENABLE_STAPLES_CRON=true
ENABLE_STORE_ROUTE_ORDERING=true
ENABLE_ANONYMOUS_AUTH=true
