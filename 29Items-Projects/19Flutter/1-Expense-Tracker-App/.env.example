# Compile-time configuration template — docs/TECH-NOTES.md §3.4.
#
# Flutter has NO runtime .env: this file is only ever consumed at build time via
# `--dart-define-from-file` (see scripts/dart_define.sh), read through
# `String.fromEnvironment` in lib/core/config/env.dart. A bundled .env asset would
# ship inside the APK/IPA and be trivially readable by anyone who unzips it — so
# this file holds PLACEHOLDERS only, is committed, and is never a secret store.
#
# Copy this to `.env` (git-ignored) and fill in real values for local development.
# Never commit a real `.env`. In Codemagic these are injected from an encrypted
# environment variable group at build time — the repo itself never holds a secret.

# dev | staging | prod — selects flavour-specific behaviour in lib/core/config/env.dart.
APP_FLAVOR=dev

# FX rates endpoint. Leave empty to disable live rates entirely — the app runs
# fully offline on manually entered/cached rates (Env.fxEnabled becomes false).
FX_API_BASE_URL=

# SECURITY: FX_API_KEY ships inside the compiled binary and is trivially
# extractable by anyone with the APK/IPA. Only ever configure a rate-limit-scoped
# key here — never a billable or privileged secret.
FX_API_KEY=

# Seed demo expenses on first run — dev convenience only, never set in staging/prod.
SEED_DEMO_DATA=false

# Overrides the log floor (e.g. debug, info, warn, error). Empty = decide from build mode.
LOG_LEVEL=

# TODO(phase3): flip to true once Hive encryption + Keystore key storage land.
ENCRYPT_BOXES=false
