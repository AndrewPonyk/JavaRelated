# Habit Streak Tracker - Environment Configuration Template

# Environment Profile (development, staging, production)
APP_ENV=development
APP_NAME=Habit Streak Tracker
APP_BUNDLE_ID=com.example.habitstreaktracker.dev

# Feature Flags
ENABLE_STREAK_FREEZE=true
ENABLE_CALENDAR_HEATMAP=true
ENABLE_HOME_WIDGET=true
ENABLE_REMINDERS=true

# Notification Settings
NOTIFICATION_CHANNEL_ID=habit_reminders_channel
NOTIFICATION_CHANNEL_NAME=Habit Daily Reminders
NOTIFICATION_CHANNEL_DESC=Notifications for daily habit streak reminders

# Database Configuration
DATABASE_NAME=habit_tracker.db
DATABASE_VERSION=2

# Home Screen Widget Settings
APP_GROUP_ID=group.com.example.habitstreaktracker
ANDROID_WIDGET_NAME=HabitAppWidgetProvider
IOS_WIDGET_KIND=HabitStreakWidget

# Firebase App Distribution & CI Secrets
FIREBASE_APP_ID_ANDROID=1:123456789012:android:abcdef1234567890
FIREBASE_APP_ID_IOS=1:123456789012:ios:abcdef1234567890
FIREBASE_CLI_TOKEN=your_firebase_ci_token_here
FIREBASE_TESTER_GROUPS=internal-qa,core-devs
