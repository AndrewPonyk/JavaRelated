# CLI DevOps Tool local environment template.
# Do not commit real secrets in .env files.

DEVOPSCTL_CONFIG=./configs/config.example.yaml
DEVOPSCTL_DB_PATH=./devopsctl.sqlite
DEVOPSCTL_LOG_LEVEL=info
DEVOPSCTL_OUTPUT=table

DEVOPSCTL_AWS_REGION=us-east-1
DEVOPSCTL_AWS_PROFILE=

DEVOPSCTL_DOCKER_HOST=

# Required only when optional local API mode is exposed beyond localhost.
DEVOPSCTL_API_TOKEN=change-me-for-local-api
