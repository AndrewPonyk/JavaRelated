APP_ENV=development
HTTP_ADDR=:8080
POSTGRES_USER=task_queue
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=task_queue
DATABASE_URL=postgres://task_queue:replace-with-local-postgres-password@localhost:5432/task_queue?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
NATS_URL=nats://localhost:4222
API_KEY=replace-with-local-api-key
AUTO_MIGRATE=true
ENFORCE_HTTPS=false
WORKER_CONCURRENCY=8
SHUTDOWN_TIMEOUT_SECONDS=20
METRICS_ENABLED=true
