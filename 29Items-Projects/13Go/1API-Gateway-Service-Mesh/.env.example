APP_ENV=local
HTTP_ADDR=:8080
ADMIN_API_KEY=local-dev-key
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
DEFAULT_RATE_LIMIT_PER_MINUTE=120
GRPC_ROUTE_SERVICE_ADDR=localhost:9090
JWT_SHARED_SECRET=local-dev-jwt-secret
AUTH_MODE=permissive
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
AWS_REGION=us-east-1
ECR_REPOSITORY=api-gateway
