# ==============================================================================
# quantfinlib API — environment template
# Copy to `.env` for local dev (never commit .env). This file is the
# authoritative list of all config; test_config_documented enforces it.
# ==============================================================================

# --- Runtime -----------------------------------------------------------------
QF_ENV=dev                          # dev | staging | prod (prod: JSON logs, docs UI off)
QF_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
QF_REQUIRE_NATIVE=0                 # 1 = refuse to start without the C++ extension (set 1 in prod)

# --- HTTP --------------------------------------------------------------------
QF_HOST=0.0.0.0
QF_PORT=8000
QF_CORS_ORIGINS=http://localhost:8000    # comma-separated allowed origins
QF_RATE_LIMIT=120/minute                 # per API key

# --- Auth --------------------------------------------------------------------
# Comma-separated API-key entries: "<sha256-hex>" grants all scopes,
# "<sha256-hex>:scope1|scope2" restricts to those scopes (price, fit, admin).
# Empty in dev mode = anonymous access with all scopes (local only).
# Example below is sha256("dev-key") limited to pricing; replace in staging/prod.
QF_API_KEY_HASHES=7e9f8fd111802be56c379d597842e29b2cebd35ff2133d431a49fa556a18704e:price

# --- Database ----------------------------------------------------------------
# Local dev default is SQLite; compose/prod use Postgres.
QF_DATABASE_URL=sqlite+aiosqlite:///./quantfin_dev.db
# QF_DATABASE_URL=postgresql+asyncpg://quantfin:CHANGE_ME@localhost:5432/quantfin

# --- ML ----------------------------------------------------------------------
QF_ML_DEVICE=cpu                    # cpu | cuda
QF_ML_MAX_FIT_SECONDS=600           # hard cap on a single vol-surface fit job

# --- Monte Carlo guards ------------------------------------------------------
QF_MC_MAX_PATHS=10000000            # reject API requests above this (memory guard)
QF_MC_DEFAULT_SEED=42
