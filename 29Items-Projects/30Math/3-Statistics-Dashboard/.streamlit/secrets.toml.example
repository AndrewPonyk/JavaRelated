# Template for Streamlit secrets.
#   Local:  copy to .streamlit/secrets.toml (gitignored).
#   Cloud:  paste into the app's Secrets UI (Manage app → Settings → Secrets).
# Flat scalar keys are lowercased and merged over env/.env by app/core/config.py.

APP_ENV = "production"
DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/stats_dashboard?sslmode=require"
MAX_UPLOAD_MB = 25
# SENTRY_DSN = "https://...@sentry.io/..."  # optional; requires sentry-sdk in requirements
