# ────────────────────────────────────────────────────────────────────────────
# Server-side (Vercel Functions only — NEVER exposed to the browser)
# ────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In serverless, use a POOLED string
# (Neon pooler / pgbouncer) — direct connections get exhausted under load.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linalg_viz?schema=public"

# Direct (non-pooled) connection — used only by `prisma migrate`.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linalg_viz?schema=public"

# ────────────────────────────────────────────────────────────────────────────
# Client-side (bundled into the JS — MUST start with VITE_, never put secrets here)
# ────────────────────────────────────────────────────────────────────────────
# Where the SPA finds the API. "/api" for same-origin (vercel dev / deployed);
# point at a deployed preview URL for frontend-only dev against a real backend.
VITE_API_BASE_URL="/api"
