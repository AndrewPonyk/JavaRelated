# ============================================================================
#  Algorithmic Trading Platform — environment template
#  Copy to `.env` for local dev. NEVER commit real secrets.
#  In staging/prod these are injected by HashiCorp Vault at runtime.
# ============================================================================

# ---- Runtime ----
ENV=dev                                   # dev | staging | prod
LOG_LEVEL=INFO                            # DEBUG | INFO | WARN | ERROR
SERVICE_NAME=api-gateway

# ---- PostgreSQL (system of record) ----
DATABASE_URL=postgresql://trader:changeme@localhost:5432/trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading

# ---- Redis (hot state / cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Kafka (event backbone) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_GROUP=strategy-engine
# SASL/TLS — leave blank locally; required in staging/prod
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---- API gateway ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Auth (api-gateway) ----
AUTH_ENABLED=false                        # true => require a verified Bearer JWT
JWT_SECRET=                               # HS256 shared secret (or RS256 public key); REQUIRED when AUTH_ENABLED in non-dev
JWT_ALGORITHM=HS256                       # HS256 | RS256 | ...
JWT_AUDIENCE=                             # optional expected `aud` claim (blank = not checked)

# ---- Indicators ----
TRADING_USE_TALIB=0                       # 1 => route indicators through native TA-Lib instead of NumPy

# ---- Broker / FIX (execution-engine) — SECRET, Vault-only in prod ----
FIX_SENDER_COMP_ID=TRADINGPLATFORM
FIX_TARGET_COMP_ID=BROKER
FIX_HOST=127.0.0.1
FIX_PORT=9876
FIX_USERNAME=
FIX_PASSWORD=
FIX_RESET_SEQ_NUM=Y                       # dev only; never in prod

# ---- Risk limits (defaults; authoritative values live in risk-engine config) ----
RISK_MAX_POSITION_QTY=10000
RISK_MAX_ORDER_NOTIONAL=250000
RISK_MAX_DAILY_LOSS=50000
RISK_KILL_SWITCH=off                      # on => reject all new orders

# ---- ML model serving ----
ML_MODEL_REGISTRY_URI=file://./models
ML_INFERENCE_ENDPOINT=http://localhost:8501

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9100
