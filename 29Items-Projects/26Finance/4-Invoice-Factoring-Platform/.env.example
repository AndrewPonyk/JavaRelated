# =========================================================================
#  Invoice Factoring Platform — environment template
#  Copy to `.env` (git-ignored) for local development.
#  In Azure, these are injected from Azure Key Vault via the AKS CSI driver
#  — NEVER commit real secrets.
# =========================================================================

# ---- Runtime ----
ASPNETCORE_ENVIRONMENT=Development
API_BASE_URL=https://localhost:7080

# ---- SQL Server ----
# Local dev points at the docker-compose SQL Server instance.
CONNECTIONSTRINGS__SQLSERVER=Server=localhost,1433;Database=InvoiceFactoring;User Id=sa;Password=Your_strong_Pass123;TrustServerCertificate=True;Encrypt=True

# ---- Redis ----
CONNECTIONSTRINGS__REDIS=localhost:6379

# ---- Azure Service Bus (use Azurite/emulator or a dev namespace) ----
SERVICEBUS__CONNECTIONSTRING=Endpoint=sb://localhost/;SharedAccessKeyName=...;SharedAccessKey=...
SERVICEBUS__UNDERWRITINGQUEUE=invoice-underwriting
SERVICEBUS__PAYMENTSQUEUE=payment-events

# ---- Stripe ----
STRIPE__SECRETKEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE__PUBLISHABLEKEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE__WEBHOOKSECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE__CONNECTCLIENTID=ca_xxxxxxxxxxxxxxxxxxxx

# ---- Plaid ----
PLAID__CLIENTID=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID__SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID__ENVIRONMENT=sandbox            # sandbox | development | production

# ---- Auth (Azure AD B2C / OpenID Connect) ----
AUTH__AUTHORITY=https://invoicefactoring.b2clogin.com/invoicefactoring.onmicrosoft.com/B2C_1_signupsignin/v2.0
AUTH__AUDIENCE=api://invoice-factoring-api
AUTH__CLIENTID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- ML model ----
ML__MODELPATH=./models/credit-risk-v1.zip
ML__SCORINGTHRESHOLD=0.35             # PD above which an invoice is auto-declined

# ---- Observability ----
APPLICATIONINSIGHTS__CONNECTIONSTRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# ---- Frontend (Vite — must be VITE_ prefixed to be exposed to the browser) ----
VITE_API_BASE_URL=https://localhost:7080
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_PLAID_ENV=sandbox
