{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "SqlServer": "",
    "Redis": ""
  },
  "Auth": {
    "Authority": "",
    "Audience": "api://invoice-factoring-api"
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "ConnectClientId": ""
  },
  "Plaid": {
    "ClientId": "",
    "Secret": "",
    "Environment": "sandbox"
  },
  "ServiceBus": {
    "ConnectionString": "",
    "UnderwritingQueue": "invoice-underwriting",
    "PaymentsQueue": "payment-events"
  },
  "ML": {
    "ModelPath": "./models/credit-risk-v1.zip",
    "ScoringThreshold": 0.30
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
