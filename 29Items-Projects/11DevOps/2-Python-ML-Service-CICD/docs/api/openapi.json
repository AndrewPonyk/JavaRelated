{
  "components": {
    "schemas": {
      "ABConfig": {
        "description": "Current champion/challenger traffic-split configuration.",
        "properties": {
          "challenger_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenger Version"
          },
          "champion_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Champion Version"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "traffic_split": {
            "description": "Percent of traffic sent to challenger.",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Traffic Split",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "traffic_split",
          "model_name"
        ],
        "title": "ABConfig",
        "type": "object"
      },
      "ABConfigUpdate": {
        "description": "Runtime update of the A/B experiment configuration.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "traffic_split": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Percent of traffic sent to challenger.",
            "title": "Traffic Split"
          }
        },
        "title": "ABConfigUpdate",
        "type": "object"
      },
      "DriftReportListResponse": {
        "description": "Recent drift reports (newest first).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DriftReportRecord"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "DriftReportListResponse",
        "type": "object"
      },
      "DriftReportRecord": {
        "description": "A persisted drift report row.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "drift_detected": {
            "title": "Drift Detected",
            "type": "boolean"
          },
          "feature_name": {
            "title": "Feature Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "psi_score": {
            "title": "Psi Score",
            "type": "number"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          },
          "window_end": {
            "format": "date-time",
            "title": "Window End",
            "type": "string"
          },
          "window_start": {
            "format": "date-time",
            "title": "Window Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "feature_name",
          "psi_score",
          "threshold",
          "drift_detected",
          "window_start",
          "window_end",
          "created_at"
        ],
        "title": "DriftReportRecord",
        "type": "object"
      },
      "DriftStatus": {
        "description": "Result of a PSI drift check for one feature.",
        "properties": {
          "drift_detected": {
            "title": "Drift Detected",
            "type": "boolean"
          },
          "feature_name": {
            "title": "Feature Name",
            "type": "string"
          },
          "psi_score": {
            "title": "Psi Score",
            "type": "number"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "feature_name",
          "psi_score",
          "threshold",
          "drift_detected"
        ],
        "title": "DriftStatus",
        "type": "object"
      },
      "DriftSummary": {
        "description": "Aggregated drift evaluation over the recent prediction window.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "evaluated_rows": {
            "default": 0,
            "title": "Evaluated Rows",
            "type": "integer"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/DriftStatus"
            },
            "title": "Features",
            "type": "array"
          },
          "retraining_triggered": {
            "default": false,
            "title": "Retraining Triggered",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "drift_detected",
              "insufficient_data"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DriftSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelAliases": {
        "description": "Current alias -> version mapping.",
        "properties": {
          "challenger": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenger"
          },
          "champion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Champion"
          }
        },
        "title": "ModelAliases",
        "type": "object"
      },
      "ModelListResponse": {
        "description": "All known model versions plus the alias mapping.",
        "properties": {
          "aliases": {
            "$ref": "#/components/schemas/ModelAliases"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModelVersionInfo"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "aliases"
        ],
        "title": "ModelListResponse",
        "type": "object"
      },
      "ModelVersionInfo": {
        "description": "A registered model version.",
        "properties": {
          "auc": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auc"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "registered_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registered At"
          },
          "source": {
            "default": "local",
            "description": "Registry tier the version lives in: \"local\"|\"mlflow\".",
            "title": "Source",
            "type": "string"
          },
          "stage": {
            "description": "Registry alias/stage: \"champion\", \"challenger\" or \"archived\".",
            "title": "Stage",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "stage"
        ],
        "title": "ModelVersionInfo",
        "type": "object"
      },
      "PredictionListResponse": {
        "description": "A page of persisted predictions.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PredictionRecord"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PredictionListResponse",
        "type": "object"
      },
      "PredictionRecord": {
        "description": "A persisted prediction audit record.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "features": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Features"
          },
          "fraud_probability": {
            "title": "Fraud Probability",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_fraud": {
            "title": "Is Fraud",
            "type": "boolean"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          },
          "variant": {
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "id",
          "transaction_id",
          "account_id",
          "amount",
          "model_version",
          "variant",
          "fraud_probability",
          "is_fraud",
          "latency_ms"
        ],
        "title": "PredictionRecord",
        "type": "object"
      },
      "PredictionRequest": {
        "description": "A single transaction to score for fraud.",
        "properties": {
          "account_id": {
            "description": "Account the transaction belongs to (A/B routing key).",
            "minLength": 1,
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "description": "Transaction amount; must be positive.",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "type": "number"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Optional pre-computed extra features.",
            "title": "Features",
            "type": "object"
          },
          "merchant_category": {
            "description": "Merchant category code or name.",
            "minLength": 1,
            "title": "Merchant Category",
            "type": "string"
          },
          "timestamp": {
            "description": "Transaction timestamp (ISO 8601).",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "transaction_id": {
            "description": "Unique transaction identifier.",
            "minLength": 1,
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "account_id",
          "amount",
          "merchant_category",
          "timestamp"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Fraud score for a transaction.",
        "properties": {
          "fraud_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fraud Probability",
            "type": "number"
          },
          "is_fraud": {
            "title": "Is Fraud",
            "type": "boolean"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          },
          "variant": {
            "description": "A/B variant that served the request: \"champion\"|\"challenger\".",
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "model_version",
          "variant",
          "fraud_probability",
          "is_fraud",
          "latency_ms"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "PromoteRequest": {
        "description": "Request to point a registry alias at a specific model version.",
        "properties": {
          "alias": {
            "default": "champion",
            "enum": [
              "champion",
              "challenger"
            ],
            "title": "Alias",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "PromoteRequest",
        "type": "object"
      },
      "PromoteResponse": {
        "description": "Outcome of an alias promotion.",
        "properties": {
          "alias": {
            "title": "Alias",
            "type": "string"
          },
          "previous": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Version the alias pointed at before the promotion.",
            "title": "Previous"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "alias"
        ],
        "title": "PromoteResponse",
        "type": "object"
      },
      "RetrainJobStatus": {
        "description": "Full status of a retraining job.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "On success: new version and its evaluation metrics.",
            "title": "Result"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "submitted"
            ],
            "title": "Status",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "reason",
          "submitted_at"
        ],
        "title": "RetrainJobStatus",
        "type": "object"
      },
      "RetrainRequest": {
        "description": "Manual retraining trigger.",
        "properties": {
          "reason": {
            "default": "manual",
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "RetrainRequest",
        "type": "object"
      },
      "RetrainResponse": {
        "description": "Acknowledgement of an asynchronous retraining job submission.",
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "reason",
          "submitted_at"
        ],
        "title": "RetrainResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "fraud-detection-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/drift": {
      "get": {
        "description": "Evaluate drift of recent production features against the champion baseline.",
        "operationId": "drift_status_api_v1_admin_drift_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriftSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Drift Status",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/drift/reports": {
      "get": {
        "description": "Return the most recent persisted drift reports.",
        "operationId": "drift_reports_api_v1_admin_drift_reports_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriftReportListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Drift Reports",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/retrain": {
      "post": {
        "description": "Manually trigger model retraining (bypasses the drift debounce).",
        "operationId": "trigger_retraining_api_v1_admin_retrain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RetrainRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrainResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trigger Retraining",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/retrain/{job_id}": {
      "get": {
        "description": "Return the status of a retraining job.",
        "operationId": "retraining_status_api_v1_admin_retrain__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrainJobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retraining Status",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "List every known model version plus the current alias mapping.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/v1/models/ab-config": {
      "get": {
        "description": "Return the effective champion/challenger traffic-split configuration.",
        "operationId": "get_ab_config_api_v1_models_ab_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ABConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Ab Config",
        "tags": [
          "models"
        ]
      },
      "put": {
        "description": "Update the experiment configuration at runtime (per-process override).",
        "operationId": "update_ab_config_api_v1_models_ab_config_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ABConfigUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ABConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Ab Config",
        "tags": [
          "models"
        ]
      }
    },
    "/api/v1/models/promote": {
      "post": {
        "description": "Point an alias at a model version (e.g. promote challenger to champion).",
        "operationId": "promote_model_api_v1_models_promote_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromoteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Promote Model",
        "tags": [
          "models"
        ]
      }
    },
    "/api/v1/models/{version}": {
      "delete": {
        "description": "Delete an archived model version (the champion is protected).",
