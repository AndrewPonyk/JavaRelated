# ---------------------------------------------------------------------------
# Fraud Detection API — environment configuration
# Copy to .env and adjust. All app settings use the FRAUD_ prefix
# (see src/fraud_detection/core/config.py).
# ---------------------------------------------------------------------------

# Application identity / runtime
FRAUD_APP_NAME=fraud-detection-api
# One of: local, dev, staging, prod
FRAUD_ENVIRONMENT=local
FRAUD_DEBUG=false
# One of: DEBUG, INFO, WARNING, ERROR
FRAUD_LOG_LEVEL=INFO

# Database (SQLAlchemy URL). Local default is a zero-setup SQLite file;
# docker compose and Kubernetes override this with PostgreSQL
# (postgresql+psycopg2://fraud:fraud@db:5432/fraud).
FRAUD_DATABASE_URL=sqlite:///./fraud.db
# Create missing tables at startup (dev convenience; prod uses Alembic via
# scripts/entrypoint.sh)
FRAUD_DB_AUTO_CREATE=true

# MLflow tracking server (optional tier - the local model store always works).
# In docker compose the host is "mlflow".
FRAUD_MLFLOW_TRACKING_URI=http://localhost:5000
# Registered model name (aliases: champion, challenger)
FRAUD_MODEL_NAME=fraud-detection
# Local model store directory (versioned artifacts + registry.json)
FRAUD_MODEL_DIR=models

# A/B testing: deterministic traffic split between champion and challenger
FRAUD_AB_TEST_ENABLED=true
# Percent of traffic routed to the challenger model (0-100)
FRAUD_AB_TRAFFIC_SPLIT=10

# Drift detection: PSI above this threshold flags drift and can trigger retraining
FRAUD_DRIFT_PSI_THRESHOLD=0.2
# How many recent predictions form the drift evaluation window
FRAUD_DRIFT_WINDOW_SIZE=500
# Minimum rows required before drift is evaluated at all
FRAUD_DRIFT_MIN_ROWS=50
# Automatically submit retraining when drift is detected
FRAUD_AUTO_RETRAIN_ON_DRIFT=true
# Debounce window between automatic drift-triggered retrainings (minutes)
FRAUD_RETRAIN_MIN_INTERVAL_MINUTES=60

# Training data: CSV path with columns amount, merchant_category, timestamp,
# is_fraud. Empty = built-in synthetic generator (demo data source).
FRAUD_TRAINING_DATA_PATH=
# Sample count for synthetic training runs
FRAUD_TRAINING_SAMPLES=20000

# Prometheus /metrics endpoint
FRAUD_METRICS_ENABLED=true

# Prefix for all business API routes (predictions, models, admin)
FRAUD_API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# docker-compose only
# ---------------------------------------------------------------------------
# PostgreSQL container bootstrap credentials (must match the compose
# FRAUD_DATABASE_URL override)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
