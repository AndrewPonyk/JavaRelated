root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 140

[*.{yml,yaml,json,tpl}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
