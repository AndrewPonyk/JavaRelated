# =====================================================================
# .env.example — copy to `.env` for local development. NEVER commit .env.
# Staging/production values come from Helm values + ExternalSecrets, not
# from this file. CI values live in GitHub Actions variables/secrets.
# =====================================================================

# ── Order Service runtime ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Actuator (health/metrics/prometheus) — separate port, never ingress-routed
MANAGEMENT_SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orders
SPRING_DATASOURCE_USERNAME=orders
SPRING_DATASOURCE_PASSWORD=orders-local-pw
# HikariCP pool size (pods × pool must stay below RDS max_connections)
DB_POOL_SIZE=10
# Extra JVM flags for local runs (containers set this in the Dockerfile)
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# ── docker-compose local infrastructure ──────────────────────────────
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders-local-pw
POSTGRES_PORT=5432
GRAFANA_ADMIN_PASSWORD=admin

# ── CI/CD reference (configure in GitHub → Settings, NOT here) ───────
# Repository variables:
#   AWS_REGION       = eu-central-1
#   AWS_ROLE_ARN     = arn:aws:iam::<account-id>:role/github-oidc-order-service
#   ECR_REPOSITORY   = order-service
#   SONAR_HOST_URL   = https://sonar.example.com
# Repository secrets:
#   SONAR_TOKEN      = <sonarqube analysis token>
