# ══════════════════════════════════════════════════════════════════════════════
# Customer Portal SPA — environment template
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# ⚠️  SECURITY: every VITE_* value is embedded into the PUBLIC JS bundle at build
#     time. NEVER put secrets (API keys, tokens, passwords) in VITE_* variables.
#     Secrets live in GitHub Environments only. See docs/TECH-NOTES.md §3.4.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application (baked into the bundle) ─────────────────────────────────────────
# Which environment this build believes it is in: local | e2e | preview | staging | production
VITE_ENV_NAME=local

# Base URL of the Portal API. With MSW enabled, requests to /api/* are intercepted in-browser.
VITE_API_BASE_URL=/api

# Serve the app against the MSW mock backend (true for local dev / hermetic E2E / previews).
VITE_ENABLE_MSW=true

# GA4 measurement id (G-XXXXXXXXXX). Leave empty to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=

# Injected by CI as the git SHA; 'dev' locally.
VITE_APP_VERSION=dev

# ── Tooling (NOT baked into the bundle) ─────────────────────────────────────────
# Run Playwright against a deployed URL instead of the local hermetic build.
PLAYWRIGHT_BASE_URL=

# Used only by CI / scripts/deploy-pr-preview.sh (values come from GitHub vars in CI):
PREVIEW_BUCKET=
PREVIEW_CF_DISTRIBUTION_ID=
PREVIEW_DOMAIN=

# Optional: Lighthouse CI GitHub App token for status-check links (npm run lighthouse).
LHCI_GITHUB_APP_TOKEN=

# CI-only credentials (DIGITALOCEAN_ACCESS_TOKEN, AWS_ROLE_ARN) are NOT env-file material —
# they live exclusively in GitHub Environments. Inventory: docs/TECH-NOTES.md §3.4.
