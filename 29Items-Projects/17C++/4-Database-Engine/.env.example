# MiniDB configuration template.
# Copy to `.env` and adjust. `.env` is git-ignored — never commit real values.
# MiniDB holds no secrets; these are runtime tunables only. Compiled-in defaults
# apply when a variable is unset, so MiniDB runs with zero config.

# ---------------------------------------------------------------------------
# Active (read at runtime)
# ---------------------------------------------------------------------------

# Number of frames in the buffer pool (each frame caches one 4 KiB page).
# Read by Database::Open via getenv; values < 2 fall back to the default.
# 1024 frames = 4 MiB resident cache.
MINIDB_BUFFER_POOL_PAGES=1024

# ---------------------------------------------------------------------------
# Reserved (documented surface for planned features — not yet wired)
# ---------------------------------------------------------------------------

# Directory convention for *.db files (the CLI takes the path as an argument).
MINIDB_DATA_DIR=./data
# Page size is fixed at build time (PAGE_SIZE); shown here for reference only.
MINIDB_PAGE_SIZE=4096
# Logger verbosity (TRACE|DEBUG|INFO|WARN|ERROR) — pending the structured logger.
MINIDB_LOG_LEVEL=INFO
# mmap vs. buffered pread/pwrite fallback — pending the buffered I/O path.
MINIDB_MMAP_ENABLED=1
# Flush policy (msync on commit) — FlushAll() currently always syncs.
MINIDB_SYNC_ON_COMMIT=1
