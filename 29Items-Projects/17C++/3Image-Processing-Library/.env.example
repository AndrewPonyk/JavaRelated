# .env.example — copy to .env and adjust. NEVER commit a real .env.
# No secrets are required by the library or CLI; the entries below are plain
# runtime configuration (12-factor style).

# === Consumed by the CLI today ============================================
# Compute device: cpu | cuda:0 | cuda:1 ...  (CLI default for --device)
IMGPROC_DEVICE=cpu

# Allow-listed directory that model artifacts MUST live under. Enforced by
# ml::ModelRunner (path is canonicalised + checked; artifacts outside are
# rejected). CLI default for --model-dir.
IMGPROC_MODEL_DIR=./models

# === Reserved for the service-embedding milestone =========================
# These are documented for the planned host-service integration (see
# ARCHITECTURE.md §2.7) and are NOT yet read by the current library/CLI.

# Environment selector: dev | staging | prod
IMGPROC_ENV=dev

# Logging verbosity: trace | debug | info | warn | error | critical
IMGPROC_LOG_LEVEL=info

# Number of CUDA streams used for pipelining (GPU builds only).
IMGPROC_NUM_STREAMS=2

# Model-registry DB DSN (the embedded build uses a SQLite file path directly).
#   dev  : sqlite:///./registry.db
#   prod : postgresql://USER:PASSWORD@host:5432/imgproc   # inject via secrets manager
IMGPROC_REGISTRY_URL=sqlite:///./registry.db

# Decode-hardening limits (guard against decompression bombs).
IMGPROC_MAX_IMAGE_WIDTH=16384
IMGPROC_MAX_IMAGE_HEIGHT=16384
IMGPROC_MAX_IMAGE_BYTES=268435456
