# .env.example — used by CI and the optional network stream, not by core polling.
# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# --- Build / CI ---
CMAKE_BUILD_TYPE=Release          # Debug | Release | RelWithDebInfo
PPMON_TARGET_ARCH=x64             # x64 | arm64
PPMON_ENABLE_ANALYZE=             # set to 1 to enable MSVC /analyze in the build

# --- Runtime (optional WinSock2 streaming) ---
PPMON_LISTEN_ADDR=127.0.0.1       # bind address for the metric stream server
PPMON_LISTEN_PORT=9555            # TCP port
PPMON_STREAM_TOKEN=               # shared token for remote subscribers (empty = auth disabled)

# --- Test toggles ---
PPMON_RUN_INTEGRATION=0           # 1 enables live-OS integration tests in CTest

# --- Release (provided by CI as secrets; do NOT put real values here) ---
GH_RELEASE_TOKEN=
