# Static analysis focused on correctness, bug-prone patterns, and portability.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  -bugprone-easily-swappable-parameters,
  -misc-no-recursion

WarningsAsErrors: 'clang-analyzer-*,bugprone-*'
HeaderFilterRegex: '.*/(include|src)/.*'
FormatStyle: file
