# ===========================================================================
#  Memory Allocator — optional runtime tunables
#  Copy to `.env` and adjust. These are NON-SENSITIVE knobs read at startup;
#  there are no secrets in this project.
# ===========================================================================

# Placement strategy used by the demo / default init: first | best | buddy
MEMALLOC_STRATEGY=first

# Buddy-system arena size in bytes (power of two recommended).
MEMALLOC_ARENA_SIZE=1048576

# Force runtime debug checks (leak/canary tracking) even in release builds.
# 0 = off, 1 = on. (Compile-time -DMEM_DEBUG always enables them.)
MEMALLOC_DEBUG=0

# Diagnostic verbosity: off | warn | info | debug
MEMALLOC_LOG_LEVEL=warn
