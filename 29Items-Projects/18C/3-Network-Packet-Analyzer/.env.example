# .env.example — copy to .env (gitignored). Env vars override config-file
# values and are themselves overridden by CLI flags. See docs/TECH-NOTES.md §3.4.

# ---- Capture ----
NPA_INTERFACE=eth0            # NIC to capture on (ignored if NPA_PCAP_FILE set)
NPA_PCAP_FILE=                # read offline instead of live capture
NPA_BPF_FILTER=              # e.g. "tcp port 443 or udp port 53"
NPA_SNAPLEN=65535            # bytes captured per packet
NPA_PROMISC=1                # 1 = promiscuous mode

# ---- Pipeline ----
NPA_RING_SIZE=1024           # ring buffer slots, rounded up to power of two (~64 MB at default snaplen)
NPA_RING_FULL_POLICY=drop    # drop | block
NPA_WORKERS=1                # analyzer threads (Phase 3: >1)

# ---- Detection ----
NPA_RULES_FILE=config/patterns.rules

# ---- Capture-to-disk ----
NPA_WRITE=                   # tee captured packets to this .pcap (full fidelity)

# ---- UI / logging ----
NPA_HEADLESS=0               # 1 = no ncurses (CI/scripting)
NPA_JSON=0                   # 1 = headless JSON Lines output
NPA_COUNT=0                  # stop after N packets (0 = unlimited)
NPA_STATS_INTERVAL=0         # headless: seconds between stats lines (0 = only final)
NPA_REFRESH_HZ=30            # UI redraw cap
NPA_LOG_LEVEL=info           # trace|debug|info|warn|error
NPA_LOG_FILE=                # empty = stderr; logs NEVER go to stdout
