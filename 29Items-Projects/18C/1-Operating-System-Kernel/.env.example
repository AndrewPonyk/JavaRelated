# .env.example — build configuration consumed by the Makefile (via `-include .env`).
#
# Copy to `.env` and adjust. The Makefile reads these as make variables, so the
# file must use `NAME=value` syntax (no shell expansion). Never commit your real
# `.env` — it is gitignored.

# Build profile: debug | relwd | rel   (see TECH-NOTES section 3.4)
#   debug  -> -O0 -g, asserts on, in-kernel self-tests on
#   relwd  -> -O2 -g, asserts off  (CI build)
#   rel    -> -O2,    asserts off  (shipped ISO)
BUILD=debug

# Guest RAM for `make run` / `make run-graphic`.
QEMU_MEM=128M

# Extra compile-time -D flags. Feature toggles go here, for example:
#   EXTRA_DEFINES=-DCONFIG_INTERACTIVE   # boot into the live interactive shell
#   EXTRA_DEFINES=-DCONFIG_SELFTEST      # force in-kernel self-tests in rel builds
# (debug builds already define CONFIG_SELFTEST.)
EXTRA_DEFINES=
