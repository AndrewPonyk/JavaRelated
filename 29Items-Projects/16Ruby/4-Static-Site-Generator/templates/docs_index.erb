<section class="docs-index">
  <header class="docs-index-header">
    <% if selected_version %>
      <p class="doc-version"><%= h selected_version %></p>
      <h1>Docs <%= h selected_version %></h1>
    <% else %>
      <h1>Docs</h1>
    <% end %>
  </header>

  <% if pages.empty? %>
    <p class="empty-state">No documentation pages found.</p>
  <% else %>
    <% pages.group_by(&:version).sort.reverse.each do |version, version_pages| %>
      <section class="docs-version">
        <h2>
          <a href="/docs/<%= h version %>"><%= h version %></a>
        </h2>
        <ul class="docs-page-list">
          <% version_pages.sort_by(&:slug).each do |doc_page| %>
            <li>
              <a href="/docs/<%= h doc_page.version %>/<%= h doc_page.slug %>">
                <%= h doc_page.title %>
              </a>
              <% unless doc_page.description.empty? %>
                <p><%= h doc_page.description %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</section>
