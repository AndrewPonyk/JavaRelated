<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold"><%= @project.name %> — Issues</h1>
  <%= link_to "New Issue", new_project_issue_path(@project), class: "btn" %>
</div>

<%= form_with url: project_issues_path(@project), method: :get, class: "mb-4" do |f| %>
  <%= f.search_field :q, value: @q, class: "field-input",
                         placeholder: "Search title or description..." %>
<% end %>

<div class="card">
  <table class="w-full text-sm">
    <thead class="text-xs text-gray-500 uppercase">
      <tr>
        <th class="text-left py-2">Title</th>
        <th class="text-left">Status</th>
        <th class="text-left">Priority</th>
        <th class="text-left">Assignee</th>
        <th class="text-left">Sprint</th>
      </tr>
    </thead>
    <tbody>
      <% @issues.each do |issue| %>
        <tr class="border-t">
          <td class="py-2"><%= link_to issue.title, [@project, issue], class: "text-indigo-600" %></td>
          <td><span class="text-xs px-2 py-0.5 rounded <%= status_class(issue.status) %>"><%= status_label(issue.status) %></span></td>
          <td><span class="text-xs px-2 py-0.5 rounded <%= priority_class(issue.priority) %>"><%= issue.priority %></span></td>
          <td><%= issue.assignee&.display_name || "—" %></td>
          <td><%= issue.sprint&.name || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
