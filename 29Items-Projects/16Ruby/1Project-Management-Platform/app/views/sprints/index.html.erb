<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold"><%= @project.name %> — Sprints</h1>
  <%= link_to "New Sprint", new_project_sprint_path(@project), class: "btn" %>
</div>

<div class="space-y-3">
  <% @sprints.each do |sprint| %>
    <%= link_to [@project, sprint], class: "card block hover:shadow-md transition" do %>
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-semibold"><%= sprint.name %></h2>
          <p class="text-xs text-gray-500"><%= sprint.starts_on %> → <%= sprint.ends_on %></p>
        </div>
        <div class="text-right text-sm">
          <span class="px-2 py-0.5 rounded text-xs bg-gray-100"><%= sprint.state %></span>
          <div class="text-gray-500 mt-1"><%= (sprint.completion_ratio * 100).round %>% complete</div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
