<%= form_with model: project, class: "space-y-4" do |f| %>
  <% if project.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded p-3 text-sm text-red-800">
      <%= pluralize(project.errors.count, "error") %> prevented saving:
      <ul class="list-disc pl-5">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, class: "field-input", required: true %>
  </div>
  <div>
    <%= f.label :key, "Key (2-10 uppercase letters)", class: "field-label" %>
    <%= f.text_field :key, class: "field-input font-mono", required: true %>
  </div>
  <div>
    <%= f.label :description, class: "field-label" %>
    <%= f.text_area :description, rows: 4, class: "field-input" %>
  </div>
  <%= f.submit class: "btn" %>
<% end %>
