# --- Rails ---
RAILS_ENV=development
RAILS_MASTER_KEY=replace_me_with_config_master_key
SECRET_KEY_BASE=generate_with_rails_secret
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5
PORT=3000

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pm_platform_dev
DATABASE_POOL=10

# --- Redis (separate instances in prod) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_SIDEKIQ_URL=redis://localhost:6379/2
REDIS_CABLE_URL=redis://localhost:6379/3

# --- Sidekiq ---
SIDEKIQ_CONCURRENCY=10
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change_me

# --- External services ---
ML_PREDICTOR_URL=http://localhost:8000
ML_PREDICTOR_API_KEY=dev_key_replace_in_prod
ML_PREDICTOR_TIMEOUT=5

# --- Email ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace_me
MAILER_FROM=noreply@example.com

# --- Monitoring ---
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# --- OAuth (optional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Host ---
APPLICATION_HOST=localhost:3000
FORCE_SSL=false
