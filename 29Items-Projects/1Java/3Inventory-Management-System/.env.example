# Copy to .env for Docker Compose. Values here are development-only.
COMPOSE_PROJECT_NAME=inventory-management

# MySQL
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=local-inventory-password
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PORT=3306
MYSQL_BIND_ADDRESS=127.0.0.1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_STOCK_CHANGED=inventory.stock-changed.v1
KAFKA_PORT=29092
KAFKA_BIND_ADDRESS=127.0.0.1

# Redis and forecasting
REDIS_URL=redis://redis:6379/0
FORECAST_BASE_URL=http://forecast-service:8000
FORECAST_TIMEOUT=3s
MODEL_KEY=forecast:model:active

# Backend public/local settings
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
SECURITY_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/inventory?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=inventory
SPRING_DATASOURCE_PASSWORD=local-inventory-password
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Production: set issuer/audience and enable the resource-server configuration.
OIDC_ISSUER_URI=https://identity.example.com/realms/inventory
OIDC_AUDIENCE=inventory-api
SWAGGER_UI_ENABLED=false
GRAPHIQL_ENABLED=false
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
IDEMPOTENCY_RETENTION=PT24H
IDEMPOTENCY_CLEANUP_CRON=0 15 * * * *
OUTBOX_POLL_DELAY=500
FORECAST_HORIZON_DAYS=14
FORECAST_REFRESH_CRON=0 0 2 * * ?
RECONCILIATION_CRON=0 30 2 * * ?

# Frontend values are public and embedded in browser assets. Never put secrets here.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_LOCAL_AUTH=true

# Forecast service
FORECAST_PORT=8000
FORECAST_BIND_ADDRESS=127.0.0.1
FORECAST_ALLOWED_HOSTS=localhost,127.0.0.1,forecast-service,inventory-forecast
FORECAST_REQUIRE_ADMIN_TOKEN=false
# Required when FORECAST_REQUIRE_ADMIN_TOKEN=true; supply through a secret manager.
MODEL_ADMIN_TOKEN=
LOG_LEVEL=INFO

# Bind public development HTTP ports to loopback by default.
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
