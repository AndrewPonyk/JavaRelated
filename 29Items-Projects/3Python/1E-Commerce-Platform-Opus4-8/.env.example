# ---------------------------------------------------------------------------
# Environment template. Copy to `.env` for local development.
# In staging/production these values are injected from AWS Secrets Manager /
# SSM into the ECS task definition — never commit a real .env.
# ---------------------------------------------------------------------------

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@db:5432/ecommerce
READ_REPLICA_URL=postgres://postgres:postgres@db:5432/ecommerce
DB_CONN_MAX_AGE=60

# --- Redis (separate logical DBs for cache vs broker vs results) ---
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
# Set true to run tasks inline (handy for some local debugging):
CELERY_TASK_ALWAYS_EAGER=false

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PRODUCT_INDEX=products
# Toggle catalog->ES indexing signals (set false if ES is unavailable):
SEARCH_INDEXING_ENABLED=true

# --- API rate limiting (DRF throttle rates) ---
THROTTLE_ANON=60/min
THROTTLE_USER=1000/min
THROTTLE_AUTH=10/min

# --- Email ---
# console backend prints emails to stdout in dev; use SES/SMTP in prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=orders@ecommerce.local

# --- Payments ---
# "fake" = deterministic offline gateway (tok_visa succeeds, tok_decline fails).
# "stripe" = real Stripe API (requires STRIPE_SECRET_KEY).
PAYMENT_GATEWAY=fake
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AWS / storage ---
AWS_REGION=eu-central-1
AWS_STORAGE_BUCKET_NAME=
ML_MODEL_S3_PREFIX=models/recommendations/
ML_MODEL_LOCAL_PATH=var/reco_model.pt

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend (Vite reads VITE_-prefixed vars) ---
VITE_API_BASE_URL=/api/v1
