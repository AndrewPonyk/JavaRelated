# Local development defaults. Do not commit real secrets.
APP_ENV=development
APP_NAME=Static Analyzer
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./static_analyzer.db
CORS_ORIGINS=http://localhost:5173
ANALYZER_BINARY=./analyzer/libtooling/build/static-analyzer
RULES_CONFIG=./config/rules.example.yaml
MIGRATIONS_PATH=./migrations
LOG_LEVEL=INFO
MAX_SOURCE_BYTES=1000000
MAX_PAGE_SIZE=100
GZIP_MIN_SIZE=1000
ENFORCE_HTTPS=false
ALLOWED_HOSTS=*
