# Build settings
JSENGINE_BUILD_TYPE=Debug
JSENGINE_ENABLE_JIT=true
JSENGINE_ENABLE_DEBUG_PROTOCOL=true

# Runtime settings
JSENGINE_LOG_LEVEL=info
JSENGINE_MAX_HEAP_MB=128
JSENGINE_MAX_STACK_FRAMES=4096
JSENGINE_METADATA_STORE=./build/jsengine.sqlite

# Debug protocol settings
JSENGINE_DEBUG_BIND_HOST=127.0.0.1
JSENGINE_DEBUG_BIND_PORT=9229
# Optional. Leave empty unless an embedding application exposes a remote debug adapter.
JSENGINE_DEBUG_AUTH_TOKEN=
