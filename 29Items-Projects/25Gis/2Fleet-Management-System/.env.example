# Shared
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://fleet:fleet@postgis:5432/fleet
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=fleet-api
JWT_SECRET=replace-me-for-local-development
AUTH_REQUIRED=false
AUTO_CREATE_TABLES=true
ACTIVE_VEHICLE_CACHE_TTL_SECONDS=60
ENABLE_SECURITY_HEADERS=true
GZIP_MINIMUM_SIZE=1000

# Local database container
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# AWS deployment
AWS_REGION=us-east-1
ECR_REPOSITORY_BACKEND=fleet-management-backend
ECR_REPOSITORY_FRONTEND=fleet-management-frontend
ECS_CLUSTER=fleet-management
ECS_SERVICE_API=fleet-management-api
