APP_NAME=Geospatial Analytics Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+psycopg://gis:replace-me-local-postgres-password@postgis:5432/geospatial
POSTGRES_DB=geospatial
POSTGRES_USER=gis
POSTGRES_PASSWORD=replace-me-local-postgres-password

GEOSERVER_PUBLIC_URL=http://localhost:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-me-local-geoserver-password

VITE_API_BASE_URL=http://localhost:8000
VITE_GEOSERVER_URL=http://localhost:8080/geoserver
VITE_MAPBOX_TOKEN=

JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=geospatial-platform
JWT_SECRET=replace-me-with-at-least-32-characters
AUTH_ENABLED=false
ENFORCE_HTTPS=false

ML_MODEL_PATH=/models/land-use-classifier.joblib
ML_ARTIFACT_BUCKET=local-artifacts
WORKER_CONCURRENCY=2
