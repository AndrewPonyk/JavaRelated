APP_ENV=development
APP_NAME=Address Geocoding Service
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
API_KEY_HEADER_NAME=X-API-Key

DATABASE_URL=postgresql+asyncpg://geocoder:geocoder@postgis:5432/geocoder
POSTGRES_DB=geocoder
POSTGRES_USER=geocoder
POSTGRES_PASSWORD=geocoder

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=address-geocoding-service-dev
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_CACHE_TTL_SECONDS=300

# Forward/reverse lookups may call Nominatim when true; when false the service
# answers only from its own PostGIS store (offline / test mode).
ENABLE_UPSTREAM_GEOCODER=true
# Local reverse-geocode search radius (metres) before provider fallback.
REVERSE_SEARCH_RADIUS_METERS=2000
# Max candidates returned by forward lookup / autocomplete.
GEOCODE_RESULT_LIMIT=5

VITE_API_BASE_URL=http://localhost:8000
