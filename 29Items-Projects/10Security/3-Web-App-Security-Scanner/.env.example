# ── Core ────────────────────────────────────────────────────────────────
ENV=development                    # development | staging | production
SECRET_KEY=change-me-generate-64-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:8090"]

# First admin, seeded on boot (change in any real deployment)
ADMIN_EMAIL=admin@scanner.local
ADMIN_PASSWORD=change-me-admin

# ── Database ───────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=secscanner
POSTGRES_USER=secscanner
POSTGRES_PASSWORD=change-me

# ── Scanners ───────────────────────────────────────────────────────────
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=change-me-zap-key
SQLMAP_BASE_URL=http://sqlmap:8775
SQLMAP_USERNAME=sqlmap
SQLMAP_PASSWORD=change-me-sqlmap-pass
SCAN_TIMEOUT_MINUTES=45
MAX_CONCURRENT_SCANS=3

# ── Target scoping (SSRF / authorization guardrails) ────────────────────
# Only these networks may ever be scanned (empty = hostnames unrestricted;
# deny-list for metadata/localhost always applies — see app/api/deps.py)
ALLOWED_TARGET_CIDRS=[]
# dev/lab only: allow RFC1918 targets (e.g. local vuln-lab containers)
ALLOW_PRIVATE_TARGETS=true

# ── ML classifier ──────────────────────────────────────────────────────
ML_MODEL_PATH=ml/severity_model.joblib
ML_FALLBACK_SEVERITY=medium

# ── Notifications & retention ──────────────────────────────────────────
# Slack-compatible JSON webhook fired when a scan finishes ("" = disabled)
SCAN_WEBHOOK_URL=
# Findings evidence purge after N days; 0 disables the nightly job
EVIDENCE_RETENTION_DAYS=90

# ── Frontend (build-time only) ─────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
