# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# --- Flask ---
FLASK_ENV=development            # development | testing | staging | production
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DATABASE_URL=sqlite:///crypto_toolkit.db

# --- API behaviour (safe defaults: see config.py) ---
RATELIMIT_DEFAULT=30 per minute
MAX_PAYLOAD_KB=64

# --- Auth (see config.py / auth_service.py) ---
TOKEN_TTL_HOURS=12               # signed-token lifetime for lesson-admin/audit login
AUDIT_IP_SALT=change-me-too      # per-deploy salt for salted SHA-256 IP hashes (falls back to SECRET_KEY)
SEED_LESSONS=true                # set false to skip seeding the 6 starter lessons on boot

# --- TLS demo (paths mounted into the edge nginx container) ---
TLS_CERT_PATH=/etc/nginx/tls/server.crt
TLS_KEY_PATH=/etc/nginx/tls/server.key

# --- Frontend (build-time, Vite) ---
VITE_API_BASE_URL=/api
