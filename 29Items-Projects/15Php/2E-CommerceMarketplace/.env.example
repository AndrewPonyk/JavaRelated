# =============================================================================
#  E-Commerce Marketplace — environment template
#  Copy to `.env` for local dev. NEVER commit real secrets.
#  In Azure, every value below is injected from Container Apps secrets / Key Vault.
# =============================================================================

# ---- App ----
APP_ENV=dev                       # dev | test | prod
APP_SECRET=change_me_32_char_random_string
APP_DEBUG=1

# ---- PostgreSQL (write model + event store) ----
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
# DATABASE_URL is consumed by Doctrine
DATABASE_URL="postgresql://marketplace:marketplace@postgres:5432/marketplace?serverVersion=16&charset=utf8"

# ---- RabbitMQ (Symfony Messenger async transport) ----
RABBITMQ_DEFAULT_USER=marketplace
RABBITMQ_DEFAULT_PASS=marketplace
MESSENGER_TRANSPORT_DSN="amqp://marketplace:marketplace@rabbitmq:5672/%2f/messages"

# ---- Elasticsearch (product search read model) ----
ELASTICSEARCH_URL="http://elasticsearch:9200"
ELASTICSEARCH_INDEX_PREFIX=marketplace

# ---- ML Fraud-detection micro-service ----
FRAUD_SERVICE_URL="http://ml-service:8001"
FRAUD_SERVICE_TIMEOUT_MS=800
FRAUD_SCORE_BLOCK_THRESHOLD=0.85

# ---- Auth / JWT ----
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
JWT_TTL_SECONDS=3600

# ---- CORS (frontend origin) ----
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"

# ---- Frontend (Vite — must be prefixed VITE_) ----
VITE_API_BASE_URL="http://localhost:8000/api"

# ---- Commission ----
DEFAULT_COMMISSION_RATE_BPS=1000   # 10.00% expressed in basis points
