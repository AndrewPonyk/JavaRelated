# Keep the build context lean and avoid baking host artefacts / secrets into the
# image. Dependencies are installed in the dedicated vendor stage; var/ is
# regenerated by cache:warmup.
/vendor/
/var/

# Local env overrides may hold real secrets — never copy them into an image.
/.env.local
/.env.*.local

# Dev caches & tooling artefacts.
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/phpstan-baseline.neon
/composer.phar
/.warmup.php
