{
    "name": "marketplace/backend",
    "description": "Multi-vendor e-commerce marketplace — Symfony 7 modular monolith (DDD).",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-amqp": "*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.1",
        "elasticsearch/elasticsearch": "^8.13",
        "lexik/jwt-authentication-bundle": "^3.0",
        "nelmio/cors-bundle": "^2.4",
        "symfony/console": "7.1.*",
        "symfony/dotenv": "7.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.1.*",
        "symfony/http-client": "7.1.*",
        "symfony/intl": "7.1.*",
        "symfony/messenger": "7.1.*",
        "symfony/amqp-messenger": "7.1.*",
        "symfony/property-access": "7.1.*",
        "symfony/rate-limiter": "7.1.*",
        "symfony/runtime": "7.1.*",
        "symfony/security-bundle": "7.1.*",
        "symfony/serializer": "7.1.*",
        "symfony/uid": "7.1.*",
        "symfony/validator": "7.1.*",
        "symfony/var-exporter": "7.1.*",
        "symfony/yaml": "7.1.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.0",
        "friendsofphp/php-cs-fixer": "^3.58",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-doctrine": "^1.4",
        "phpstan/phpstan-symfony": "^1.4",
        "phpunit/phpunit": "^11.2",
        "qossmic/deptrac-shim": "^1.0",
        "symfony/browser-kit": "7.1.*",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^7.1",
        "zenstruck/foundry": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "test": "phpunit",
        "qa": ["@cs", "@stan", "@deptrac", "@test"]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.1.*"
        }
    }
}
