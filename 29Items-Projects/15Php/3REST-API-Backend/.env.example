# Root-level env consumed by docker-compose.yml.
# Per-service runtime config lives in backend/.env and frontend/.env.

COMPOSE_PROJECT_NAME=marketplace

# Host port mappings
NGINX_HTTP_PORT=8080
VITE_DEV_PORT=5173
MYSQL_PORT=3306
REDIS_PORT=6379

# Image tag promoted between environments by deploy.yml
APP_IMAGE_TAG=latest
