<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="false"
         displayDetailsOnTestsThatTriggerDeprecations="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <!--
        ignoreIndirectDeprecations: report deprecations from OUR code (app/) but
        ignore those triggered indirectly by third-party/framework code — e.g.
        Laravel 11's PDO::MYSQL_ATTR_SSL_CA on PHP 8.5 (a version mismatch, not a
        project defect; CI runs PHP 8.3 where it doesn't occur at all).
    -->
    <source ignoreSelfDeprecations="true" ignoreIndirectDeprecations="true">
        <include>
            <directory>app</directory>
        </include>
    </source>

    <!-- Fast, isolated runs: in-memory SQLite + array/sync drivers. -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
