# ── App ───────────────────────────────────────────────
APP_NAME="REST API Backend"
APP_ENV=local                 # local | staging | production
APP_KEY=                      # generate: php artisan key:generate
APP_DEBUG=true                # MUST be false in staging/production
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# ── API ───────────────────────────────────────────────
API_DEFAULT_VERSION=v1
API_RATE_LIMIT_PER_MINUTE=60  # authenticated default
API_AUTH_RATE_LIMIT=5         # login/register per minute

# ── Database (MySQL 8) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=app
DB_PASSWORD=                  # secret — set per environment

# ── Redis (cache · queue · session) ───────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Auth (Sanctum) ────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

# ── CORS (allowed SPA origins, comma-separated) ───────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Mail / Notifications ──────────────────────────────
MAIL_MAILER=log               # log locally; ses/smtp in prod
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Observability ─────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug               # info/warning in prod
SENTRY_LARAVEL_DSN=

# ── Swagger ───────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8080/api/v1

# ── Recommendations ───────────────────────────────────
RECOMMENDATION_CLUSTERS=8     # k for clustering
RECOMMENDATION_TOP_N=10
