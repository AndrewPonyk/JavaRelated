###############################################################################
# Application
###############################################################################
APP_NAME="Blog Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — SQLite
# Leave DB_DATABASE unset to use the default storage/app/database.sqlite,
# OR set an ABSOLUTE path in production (relative paths are resolution-fragile).
###############################################################################
DB_CONNECTION=sqlite
# DB_DATABASE=/home/forge/blog/storage/app/database.sqlite
DB_FOREIGN_KEYS=true

###############################################################################
# Session / Cache / Queue
# Local: file/database. Production: switch CACHE_STORE & QUEUE_CONNECTION to redis.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Vite (frontend build)
###############################################################################
VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Blog domain settings (consumed by config/blog.php)
###############################################################################
# Average adult silent reading speed (~200–265 wpm); 225 is a safe default.
BLOG_WORDS_PER_MINUTE=225
# How many related posts to surface under an article.
BLOG_RELATED_POSTS_COUNT=3
# Cache lifetime (seconds) for computed TF-IDF related-post results.
BLOG_RELATED_CACHE_TTL=86400
# Characters used when auto-generating a meta description / excerpt.
BLOG_EXCERPT_LENGTH=160
# Fallback Open Graph / social-share image (path relative to the web root).
BLOG_DEFAULT_OG_IMAGE=/images/og-default.svg
