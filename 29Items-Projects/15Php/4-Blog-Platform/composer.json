{
    "name": "andrii/blog-platform",
    "type": "project",
    "description": "Personal blogging platform — Laravel 11, Livewire 3, SQLite, Markdown, SEO, TF-IDF related posts.",
    "keywords": ["laravel", "livewire", "blog", "markdown", "seo", "tf-idf"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "livewire/livewire": "^3.5",
        "league/commonmark": "^2.4",
        "ezyang/htmlpurifier": "^4.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.16",
        "larastan/larastan": "^2.9",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('storage/app/database.sqlite') || touch('storage/app/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "@php artisan test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
