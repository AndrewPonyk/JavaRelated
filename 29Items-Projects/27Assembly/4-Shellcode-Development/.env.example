# Copy to .env and override per environment (local lab vs. CTF box).
# .env is git-ignored; never commit real target credentials.

# Target connection
TARGET_HOST=127.0.0.1
TARGET_PORT=1337
# TARGET_BINARY=./vulnerable_binary   # uncomment for local process testing

# pwntools / logging
PWNLIB_DEBUG=1
LOG_LEVEL=info

# CI flags
CI_TEST_MODE=true
