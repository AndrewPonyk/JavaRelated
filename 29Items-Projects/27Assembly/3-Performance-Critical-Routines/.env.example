# .env.example — copy to .env and adjust. Sourced by scripts/run_benchmarks.sh
# and usable as `make` overrides. NEVER commit a real .env.

# ---- toolchain ----
CC=gcc                 # or clang
AS=nasm
AR=ar

# ---- build ----
BUILD=release          # debug | release
# Dev convenience uses -march=native; for PUBLISHED numbers / shipped binaries
# prefer an explicit, portable target so results are attributable.
ARCH_FLAGS=-mavx2 -mfma
# ARCH_FLAGS=-march=native
SANITIZE=0             # 1 = build with ASan+UBSan (debug only)

# ---- benchmark harness ----
BENCH_OUT=results.csv
BENCH_REPEATS=25       # timed samples per measurement (median reported)
BENCH_WARMUP=5
# BENCH_SUITE=all      # all | matrix | string

# ---- methodology (stable numbers; Linux, may need privileges) ----
CPU_PIN=2              # pin bench to this core via taskset (empty = no pin)
# Set the governor and disable turbo yourself before a publishable run, e.g.:
#   sudo cpupower frequency-set -g performance
#   echo 1 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo

# ---- install ----
PREFIX=/usr/local
