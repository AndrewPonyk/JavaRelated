# =============================================================================
#  .env.example  --  copy to .env (git-ignored) and adjust.
#  These are non-secret build/run knobs only; nothing here is a credential.
#  Sourced by tools/run-qemu.sh and overridable on the `make` command line.
# =============================================================================

# --- Toolchain ---------------------------------------------------------------
# Prefer a real cross-compiler for clean bare-metal output:
#   make CROSS=i686-elf-
# Leave empty to use the host gcc with -m32 (needs gcc-multilib on Linux).
CROSS=
NASM=nasm
HOSTCC=gcc

# --- Build -------------------------------------------------------------------
BUILD_DIR=build
OPT=-O2
KERNEL_SECTORS=50          # MUST match boot/boot.asm KERNEL_SECTORS + create_image.sh
KERNEL_LOAD_ADDR=0x1000

# --- QEMU run ----------------------------------------------------------------
QEMU=qemu-system-i386
QEMU_MEM=64M
QEMU_EXTRA="-no-reboot -no-shutdown"   # quoted: value contains a space
SERIAL=stdio              # route COM1 to terminal for logging / CI

# --- Debug (make debug + gdb) ------------------------------------------------
DEBUG_PORT=1234
