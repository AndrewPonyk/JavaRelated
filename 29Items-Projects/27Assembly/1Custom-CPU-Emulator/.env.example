# .env.example — copy to .env and adjust. .env is gitignored (never commit it).
# Precedence: CLI flag > environment variable > compiled-in default.

# Logging verbosity: trace | debug | info | warn | error | fatal
CPUEMU_LOG_LEVEL=info

# Microarchitecture to model for timing: 8086 | i486 | pentium | core2 | skylake
CPUEMU_CPU_MODEL=skylake

# Guest RAM in bytes (default 1 MiB). Accepts 0x-prefixed hex.
CPUEMU_MEM_SIZE=1048576

# 1 = run without the SDL2 window (CI / scripting); 0 = GUI if available.
CPUEMU_HEADLESS=0

# Safety cap on executed instructions (0 = unlimited).
CPUEMU_MAX_STEPS=0

# Address where flat binaries are loaded and execution begins.
CPUEMU_LOAD_ADDR=0x1000
