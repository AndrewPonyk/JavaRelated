<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ehrplatform</groupId>
        <artifactId>ehr-platform-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>event-streaming-service</artifactId>
    <name>EHR Integration Platform :: Event Streaming</name>
    <description>Kafka topology: EHR event production, consumption, projections, and DLQ handling.</description>

    <dependencies>
        <dependency>
            <groupId>com.ehrplatform</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          NOTE: an `@EmbeddedKafka` broker test (spring-kafka-test) is the ideal
          integration test and runs in CI. It is omitted from the default build
          to avoid pulling the full Kafka broker/ZooKeeper tree; the produce →
          serialize → consume → project contract is covered broker-free by
          EventEnvelopeRoundTripTest plus the consumer/projection unit tests.
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
