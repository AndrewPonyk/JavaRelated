# =============================================================================
# EHR Integration Platform — environment contract
# Copy to `.env` for local dev and fill in values. NEVER commit `.env`.
# In dev/staging/prod these come from AWS Secrets Manager via External Secrets.
# Use ONLY dummy/synthetic values here — never real PHI or production secrets.
# =============================================================================

# --- Oracle (system of record) ----------------------------------------------
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/XE
ORACLE_USERNAME=ehr_app
ORACLE_PASSWORD=change-me-locally

# --- Kafka (Amazon MSK in cloud; local broker in dev) -----------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- FHIR gateway -----------------------------------------------------------
FHIR_BASE_URL=http://localhost:8081/fhir

# --- HL7v2 ingestion --------------------------------------------------------
HL7_MLLP_PORT=2575

# --- OAuth2 / SMART-on-FHIR (identity provider) -----------------------------
OAUTH2_ISSUER_URI=https://auth.example.com/realms/ehr

# --- ML inference server ----------------------------------------------------
ML_INFERENCE_URL=http://localhost:9000

# --- Frontend (Vite; only VITE_* vars are exposed to the browser) -----------
VITE_FHIR_BASE_URL=/fhir

# --- AWS (CI/CD uses OIDC roles, NOT static keys — leave blank locally) ------
AWS_REGION=us-east-1
# AWS_ECR_PUSH_ROLE_ARN=
# AWS_DEPLOY_ROLE_ARN=
