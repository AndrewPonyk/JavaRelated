# Copy to .env for local development:  cp .env.example .env
# NEVER commit a real .env. Staging/prod resolve secrets from AWS Secrets
# Manager / SSM at task start — not from this file (TECH-NOTES §3.4).

# ── Django ───────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-50-random-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated SPA origins allowed by CORS (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgres://ctms:ctms@localhost:5432/ctms
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=false            # true in staging/prod

# ── Celery / Redis ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Security / Crypto ────────────────────────────────────
FIELD_ENCRYPTION_KEY=base64-32-byte-key-for-phi-fields
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── AWS (GovCloud) ───────────────────────────────────────
AWS_REGION=us-gov-west-1
AWS_S3_BUCKET=ctms-documents
KMS_KEY_ID=arn:aws-us-gov:kms:us-gov-west-1:ACCT:key/xxxx
# AWS credentials come from the ECS task role in deployed envs — NOT here.

# ── ML / NLP ─────────────────────────────────────────────
ML_BACKEND=local                # local | sagemaker
SAGEMAKER_ENDPOINT_NAME=ctms-eligibility-screener
ELIGIBILITY_MIN_CONFIDENCE=0.70

# ── OIDC / IdP ───────────────────────────────────────────
OIDC_ISSUER_URL=https://idp.example.gov/realms/ctms
OIDC_CLIENT_ID=ctms-web
OIDC_CLIENT_SECRET=change-me

# ── Observability ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# ── Frontend (Vite, prefixed VITE_) ──────────────────────
VITE_API_BASE_URL=/api/v1
