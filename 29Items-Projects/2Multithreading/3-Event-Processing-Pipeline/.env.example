# =============================================================================
# Event Processing Pipeline — environment variable template
#
#   cp .env.example .env          # .env is git-ignored, never commit it
#   set -a && . ./.env && set +a  # POSIX
#
# Precedence (lowest wins first):
#   defaults -> src/main/resources/application.properties
#            -> config/application-<env>.properties
#            -> environment variables (this file)
#            -> CLI flags (--pipeline.batch.size=256, always wins)
#
# Naming rule: property key, upper-snake-cased, PIPELINE_ prefix.
#   pipeline.queue.capacity  ->  PIPELINE_QUEUE_CAPACITY
# =============================================================================

# --- Profile -----------------------------------------------------------------
# Which config/application-<env>.properties to load: dev | staging | prod
PIPELINE_ENV=dev

# --- Stage 1: event generation -----------------------------------------------
# Total events to generate. 0 = run until PIPELINE_DURATION_SECONDS elapses.
PIPELINE_EVENT_COUNT=100000

# Target offered load in events/second. 0 = unbounded (saturation test).
PIPELINE_EVENTS_PER_SECOND=50000

# Wall-clock cap; 0 = no time limit (stop on PIPELINE_EVENT_COUNT).
PIPELINE_DURATION_SECONDS=0

# Events per queue message. 32-256 is the sweet spot; 1 makes the queue the workload.
PIPELINE_BATCH_SIZE=128

# Number of distinct synthetic sensors to emit for.
PIPELINE_SENSOR_COUNT=16

# RNG seed — fixes the generated event stream so a failure is reproducible.
PIPELINE_RANDOM_SEED=42

# --- Queues (backpressure) ---------------------------------------------------
# ArrayBlockingQueue capacity, in messages, for BOTH inter-stage queues.
# Memory ceiling per queue ~= capacity * batchSize * sizeof(SensorEvent).
PIPELINE_QUEUE_CAPACITY=64

# --- Stage 2: filtering ------------------------------------------------------
# Fixed thread pool size for filter consumers. ~= cores for CPU-bound predicates.
PIPELINE_CONSUMER_THREADS=4

# Events with value <= threshold are rejected (counted, never silently dropped).
PIPELINE_FILTER_THRESHOLD=50.0

# --- Stage 3: aggregation ----------------------------------------------------
# Dedicated ForkJoinPool parallelism (never commonPool()). 0 = availableProcessors().
PIPELINE_AGGREGATION_PARALLELISM=0

# RecursiveTask sequential cutoff, in events. 256-1024 typical.
PIPELINE_SEQUENTIAL_THRESHOLD=512

# --- Shutdown ----------------------------------------------------------------
# Seconds to wait for a graceful poison-pill drain before shutdownNow().
PIPELINE_SHUTDOWN_TIMEOUT_SECONDS=30

# Stage loop poll timeout in ms — lets a stage notice shutdown if no pill arrives.
PIPELINE_POLL_TIMEOUT_MILLIS=250

# --- Observability -----------------------------------------------------------
# Live console dashboard (off for machine-readable output / prod).
PIPELINE_DASHBOARD_ENABLED=true

# Dashboard refresh interval in ms.
PIPELINE_DASHBOARD_INTERVAL_MILLIS=500

# java.util.logging level: SEVERE|WARNING|INFO|FINE
PIPELINE_LOG_LEVEL=INFO

# --- Optional local control plane (jdk.httpserver) ---------------------------
# Off by default. When enabled it binds 127.0.0.1 ONLY and requires a token.
PIPELINE_HTTP_ENABLED=false
PIPELINE_HTTP_PORT=8080

# Shared secret for X-Pipeline-Token. REQUIRED when PIPELINE_HTTP_ENABLED=true.
# Generate: openssl rand -hex 32     (never commit a real value)
PIPELINE_HTTP_TOKEN=replace-me-with-a-random-32-byte-hex-string

# --- Optional persistence (JdbcAggregateRepository stub) ---------------------
# Leave blank to use the in-memory repository.
PIPELINE_JDBC_URL=
PIPELINE_JDBC_USER=
PIPELINE_JDBC_PASSWORD=

# Directory for file sinks (CSV). Paths are validated against this root.
PIPELINE_OUTPUT_DIR=./output
