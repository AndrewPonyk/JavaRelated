<?xml version="1.0" encoding="UTF-8"?>
<!--
  pip-persistence — SQLite adapter for the JobRepository port.

  The canonical SQL lives in /migrations at the repo root (single source of truth,
  reviewable as plain SQL). This POM copies it onto the classpath at db/migration/
  so MigrationRunner can find it in a packaged jar too. Do not duplicate the files.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.parallelimage</groupId>
    <artifactId>pip-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>pip-persistence</artifactId>
  <name>PIP :: Persistence (SQLite adapter)</name>

  <dependencies>
    <dependency>
      <groupId>com.parallelimage</groupId>
      <artifactId>pip-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../migrations</directory>
        <targetPath>db/migration</targetPath>
        <includes>
          <include>*.sql</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
