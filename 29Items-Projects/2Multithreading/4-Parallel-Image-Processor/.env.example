# Parallel Image Processor -- environment variable configuration.
#
# Copy this file to .env (or export these directly) and edit what you need. Environment
# variables override config/application.properties but are themselves overridden by
# -Dpip.<key> JVM system properties. See AppConfig for the full precedence order.
#
# Every line here is commented out at its compiled-in default -- uncomment and edit only what
# you want to change. This file mirrors config/application.properties exactly, one entry per
# property in AppConfig.ENV_ALIASES.

# --- database / history ---------------------------------------------------

# PIP_DB_ENABLED=true
# PIP_DB_PATH=~/.pip/history.db

# --- batch processing -------------------------------------------------------

# PIP_PARALLELISM=0
# PIP_TILE_THRESHOLD=
# PIP_BATCH_THRESHOLD=
# PIP_MAX_PIXELS=

# --- output ------------------------------------------------------------------

# PIP_OUTPUT_FORMAT=
# PIP_OUTPUT_QUALITY=
# PIP_STRIP_METADATA=false
# PIP_OVERWRITE=false

# --- pipeline ------------------------------------------------------------------

# PIP_PIPELINE=

# --- local control API --------------------------------------------------------

# PIP_API_ENABLED=false
# PIP_API_PORT=8137
# PIP_API_TOKEN=

# --- retention -----------------------------------------------------------------

# PIP_RETENTION_DAYS=0

# --- logging -------------------------------------------------------------------

# PIP_LOG_FORMAT=text

# --- ui / locale ---------------------------------------------------------------

# PIP_LOCALE=
