{
  "name": "travel-agency-website",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-page static travel agency website with Bootstrap 5, Vanilla JS, Leaflet, AOS, Swiper, and Netlify Functions.",
  "scripts": {
    "build": "node tools/scripts/validate-env.js",
    "db:migrate": "node src/api/db/migrate.js",
    "lint": "eslint src netlify tests tools --ext .js",
    "start": "node src/server.js",
    "start:test": "node tools/scripts/start-test-server.js",
    "test": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "validate:env": "node tools/scripts/validate-env.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "pg-mem": "^3.0.14",
    "serve": "^14.2.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.21.0"
  }
}
