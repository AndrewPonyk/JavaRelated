# Formspree endpoint used by the Netlify reservation function.
FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Public URL used by tests, previews, analytics, and canonical tags.
PUBLIC_SITE_URL=http://localhost:5173
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=60

# Netlify deploy settings for CI/CD.
NETLIFY_SITE_ID=replace-me
NETLIFY_AUTH_TOKEN=replace-me

# Optional integrations.
ANALYTICS_ID=
DATABASE_URL=postgres://restaurant:restaurant@localhost:5432/restaurant
