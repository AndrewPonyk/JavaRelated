{
  "name": "@local/design-system-component-library",
  "version": "0.1.0",
  "private": true,
  "description": "Design system and component library with token sync, Storybook documentation, and accessibility testing.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens/design-tokens.json",
    "src/styles"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx src/api/server.ts",
    "build": "tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --coverage",
    "test:a11y": "jest tests/a11y --runInBand",
    "tokens:build": "tsx scripts/generate-token-artifacts.ts",
    "tokens:sync": "tsx scripts/sync-figma-tokens.ts && npm run tokens:build",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "release:notes": "tsx scripts/release-notes.ts",
    "api:dev": "tsx src/api/server.ts",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.2.9",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/web-components-vite": "^8.2.9",
    "@testing-library/dom": "^10.4.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "chromatic": "^11.7.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lit": "^3.1.4",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.10",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
