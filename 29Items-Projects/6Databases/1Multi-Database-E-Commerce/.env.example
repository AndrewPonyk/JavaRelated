# =====================================================================
# ShopFlow — environment template.  Copy to `.env` and fill real values.
# NEVER commit the populated .env. In AWS, these come from
# Secrets Manager / SSM Parameter Store (see infrastructure/).
# =====================================================================

# ---- Global ----
ENVIRONMENT=local            # local | dev | staging | prod
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=local

# ---- API Gateway ----
GATEWAY_PORT=8080

# ---- Oracle (order-service) ----
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=shopflow
ORACLE_PASSWORD=change-me-oracle
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1

# ---- MongoDB (catalog-service) ----
MONGODB_USER=shopflow
MONGODB_PASSWORD=change-me-mongo
MONGODB_URI=mongodb://shopflow:change-me-mongo@localhost:27017/catalog?authSource=admin
MONGODB_DATABASE=catalog

# ---- Redis (auth-service / cache) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_SSL=false

# ---- Elasticsearch (search-service) ----
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me-es

# ---- Neo4j (recommendation-service) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---- Kafka (event backbone / realtime-service) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_GROUP=shopflow

# ---- ML service ----
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# ---- Auth / JWT ----
JWT_ISSUER=https://auth.shopflow.local
JWT_SECRET=change-me-with-a-256-bit-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8086/ws

# ---- AWS (deployment) ----
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=000000000000
EKS_CLUSTER_NAME=shopflow-eks
ECR_REGISTRY=000000000000.dkr.ecr.eu-central-1.amazonaws.com
