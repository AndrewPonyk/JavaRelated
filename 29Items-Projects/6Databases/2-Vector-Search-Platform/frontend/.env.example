# Frontend environment (copy to .env.local for dev).
# Server-side only — these are read in route handlers / server components, never shipped to the browser.
BACKEND_URL=http://localhost:8000/api/v1
BACKEND_API_KEY=dev-local-key-change-me

# Public (safe to expose) values must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME=Vector Search Platform
