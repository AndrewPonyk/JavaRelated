# Copy to .env for local development. NEVER commit a real .env.
# Production/staging inject these from AWS SSM / Secrets Manager into the ECS task definition.

# ── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ── Auth ─────────────────────────────────────────────
# Required in every environment. When APP_ENV=production the app refuses to start with a
# default/blank key — inject a strong secret from AWS Secrets Manager / SSM.
API_KEY=dev-local-key-change-me

# ── PostgreSQL (pgvector) — system of record + reference backend ──
DATABASE_URL=postgresql+asyncpg://vsp:vsp@localhost:5432/vsp

# ── Redis (embedding / query cache) ──────────────────
REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_TTL=86400

# ── Embeddings ───────────────────────────────────────
# EMBEDDING_PROVIDER: auto | sentence-transformers | hashing
#   auto    -> use Sentence Transformers if available, else the offline hashing embedder
#   hashing -> deterministic, no model download (great for dev/tests/CI)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ── Ingestion / search tuning ────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
KEYWORD_CANDIDATE_LIMIT=500

# ── Default backend + feature flags ──────────────────
# DEFAULT_BACKEND: memory | pgvector | pinecone | weaviate | milvus
#   memory -> real in-process cosine store (zero external deps; ideal for local dev)
DEFAULT_BACKEND=pgvector
ENABLE_PINECONE=false
ENABLE_WEAVIATE=false
ENABLE_MILVUS=false
ENABLE_RERANKER=false

# ── Pinecone ─────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=vsp-index

# ── Weaviate ─────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=VspChunk

# ── Milvus ───────────────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=vsp_collection
