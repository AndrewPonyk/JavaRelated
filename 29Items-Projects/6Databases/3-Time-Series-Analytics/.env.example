# =============================================================================
# Time-Series Analytics — environment template
# Copy to `.env` for local dev. NEVER commit real secrets.
# Every variable the app reads MUST appear here (see docs/TECH-NOTES.md §3.4).
# =============================================================================

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=plain                   # plain | json (json in staging/prod)

# --- API ---------------------------------------------------------------------
# SAFETY RAIL: with ENVIRONMENT=production the API refuses to start while
# JWT_SECRET / ADMIN_PASSWORD / DEVICE_API_KEY still carry changeme* values.
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Must be ≥32 bytes (RFC 7518 for HS256); generate with `openssl rand -hex 32`
JWT_SECRET=changeme-dev-only-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Bootstrap dashboard admin (created at startup IF NOT EXISTS; empty password
# disables bootstrapping). Change the password immediately in real envs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin
# Shared gateway ingest key (site gateways, dev, seeding). Devices get their
# own "<device_id>.<secret>" keys at registration — those are preferred.
DEVICE_API_KEY=changeme-dev-only-shared-key
MAX_INGEST_BATCH_SIZE=5000

# --- ingest policy -------------------------------------------------------------
INGEST_MAX_AGE_HOURS=24            # points older than this are rejected
INGEST_FUTURE_TOLERANCE_MINUTES=10 # allowance for device clock skew
INGEST_RATE_LIMIT_PER_MINUTE=0     # points per device per minute; 0 = disabled

# --- Cassandra (system of record) ---------------------------------------------
CASSANDRA_CONTACT_POINTS=127.0.0.1  # comma-separated in multi-node envs
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=tsa
CASSANDRA_LOCAL_DC=datacenter1
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
RAW_TTL_SECONDS=2592000             # 30 days  (informational; enforced in CQL schema)
ROLLUP_TTL_SECONDS=31536000         # 365 days (informational; enforced in CQL schema)
ROLLUP_QUERY_THRESHOLD_HOURS=48     # ranges longer than this are served from rollups
MAX_SERIES_POINTS=5000              # larger responses are stride-decimated

# --- Redis (live aggregations + pub/sub) --------------------------------------
REDIS_URL=redis://localhost:6379/0
LIVE_WINDOW_SECONDS=60
LIVE_KEY_TTL_SECONDS=900
DEVICE_CACHE_TTL_SECONDS=60         # ingest-permission cache

# --- InfluxDB (platform telemetry) --------------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=tsa
INFLUXDB_BUCKET=platform_metrics
INFLUXDB_TOKEN=changeme-dev-token
# Used only by docker-compose influxdb bootstrap:
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme-influx

# --- Anomaly detection / workers -------------------------------------------------
DETECTION_INTERVAL_SECONDS=300
DETECTION_METHOD=auto               # auto | prophet | zscore
PROPHET_INTERVAL_WIDTH=0.95
ZSCORE_THRESHOLD=3.0
MIN_HISTORY_POINTS=48               # skip series with less history than this
WORKER_SHARD_INDEX=0                # this replica's shard (fleet sharding)
WORKER_SHARD_COUNT=1                # total worker replicas

# --- Grafana (docker-compose bootstrap) ----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Frontend -------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1          # build-time
FRONTEND_PORT=8080                 # host port for the containerized UI

# --- Deploy (server-side .env additions; CI vars stay in GitLab, masked) --------
# IMAGE_TAG=
# CI_REGISTRY_IMAGE=
