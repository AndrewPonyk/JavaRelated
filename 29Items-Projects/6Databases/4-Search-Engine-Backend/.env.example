# ============================================================================
# Search Engine Backend — environment template
# Copy to `.env` for local dev (gitignored). In staging/prod these values are
# Cloud Run env vars; secrets come from GCP Secret Manager (TECH-NOTES §3.4).
# Variable names map 1:1 to backend/app/core/config.py (pydantic-settings).
# ============================================================================

# --- App ---
ENVIRONMENT=dev                 # dev | staging | prod
DEBUG=true
API_V1_PREFIX=/api/v1
# JSON list; must include the frontend origin(s)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- PostgreSQL (catalog source of truth) ---
DATABASE_URL=postgresql+asyncpg://search:search@localhost:5432/search
DATABASE_POOL_SIZE=10

# --- Elasticsearch ---
ES_URL=http://localhost:9200
ES_API_KEY=                     # empty locally; REQUIRED in staging/prod
ES_PRODUCTS_ALIAS=products
ES_REQUEST_TIMEOUT_S=5.0

# --- Redis (autocomplete cache) ---
REDIS_URL=redis://localhost:6379/0
SUGGEST_CACHE_TTL_S=300
SUGGEST_CACHE_JITTER_S=60
SUGGEST_MIN_PREFIX_LEN=2

# --- PG -> ES outbox worker (background task inside the API process) ---
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_S=2.0
OUTBOX_BATCH_SIZE=200
OUTBOX_MAX_ATTEMPTS=10

# --- Rate limiting (per-instance backstop for /search and /suggest) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=10.0

# --- Learning to Rank ---
LTR_MODE=off                    # off | plugin (self-managed ES) | native (ES>=8.12 / Elastic Cloud)
LTR_MODEL_NAME=products_ltr_v1
LTR_RESCORE_WINDOW=100

# --- Security (rotate real values via Secret Manager — never commit them) ---
ADMIN_API_KEY=change-me
