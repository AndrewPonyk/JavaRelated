# Public browser configuration. VITE_ values are compiled into the client and are not secrets.
VITE_MODEL_MANIFEST_URL=/models/model-manifest.json
VITE_ENABLE_PRESET_API=true
VITE_API_BASE_URL=
VITE_MAX_IMAGE_PIXELS=40000000
VITE_MAX_IMAGE_BYTES=25000000
API_PROXY_TARGET=http://localhost:3000

# Docker/PostgreSQL values. Generate independent random base64url values for every secret.
POSTGRES_DB=image_editor
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
DATABASE_USER=image_editor_app
DATABASE_PASSWORD=replace-with-a-random-url-safe-runtime-password

# Direct local/Vercel API values. Never prefix secrets with VITE_.
DATABASE_URL=postgresql://image_editor_app:replace-with-url-encoded-password@localhost:5432/image_editor
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
PRESET_API_RATE_LIMIT_PER_MINUTE=60
PORT=3000
WEB_PORT=8080

# Configure deployment values in GitHub/Vercel rather than committed files.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
