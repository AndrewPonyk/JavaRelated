# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
STATIC_DIR=frontend
MIGRATIONS_DIR=migrations

# PostgreSQL
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://chat:replace-with-a-local-password@localhost:5432/chat
COMPOSE_DATABASE_URL=postgres://chat:replace-with-a-local-password@postgres:5432/chat
TEST_DATABASE_URL=postgres://chat:replace-with-a-local-password@localhost:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Observability
RUST_LOG=chat_backend=debug,tower_http=info

# Chat safety limits
ALLOWED_ORIGINS=http://localhost:8080
CHAT_CHANNEL_CAPACITY=256
MAX_MESSAGE_BYTES=4096
MAX_CONNECTIONS_PER_ROOM=500
SHUTDOWN_TIMEOUT_SECONDS=20
SESSION_TTL_HOURS=24
SECURE_COOKIES=false
MAX_LIST_PAGE_SIZE=100
MAX_HISTORY_PAGE_SIZE=100
PASSWORD_HASH_CONCURRENCY=4
MESSAGES_PER_MINUTE=60
API_REQUESTS_PER_MINUTE=300
HEARTBEAT_INTERVAL_SECONDS=20
HEARTBEAT_TIMEOUT_SECONDS=60
