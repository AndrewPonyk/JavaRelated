app = "url-shortener-api"
primary_region = "waw"

[env]
  BIND_ADDRESS = "0.0.0.0:8080"
  DATABASE_URL = "/data/url_shortener.db"
  PUBLIC_BASE_URL = "https://url-shortener-api.fly.dev"
  CORS_ALLOWED_ORIGINS = "https://url-shortener-api.fly.dev"
  TRUST_PROXY_HEADERS = "true"
  ENABLE_HSTS = "true"

[mounts]
  source = "url_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 1
