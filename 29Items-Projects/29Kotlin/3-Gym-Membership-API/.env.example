# Gym Membership API Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/gym_db
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USER=gym_admin
DATABASE_PASSWORD=super_secure_pg_password

# JWT Authentication
JWT_SECRET=gym-api-super-secret-key-32-chars-minimum-for-production
JWT_ISSUER=https://api.gymmembership.com/
JWT_AUDIENCE=gym-api-consumers
JWT_REALM=GymMembershipRealm
JWT_EXPIRATION_HOURS=24

# Gym Configuration
MAX_GYM_CAPACITY=250
ANTI_PASSBACK_COOLDOWN_MINUTES=15
EXPIRE_WARNING_DAYS_BEFORE=7

# Webhook Alert Dispatcher
WEBHOOK_ENABLED=false
WEBHOOK_ENDPOINT_URL=https://webhook.site/gym-expiry-alerts

