# Environment template — copy values into CI secrets / local shell; never commit the filled file.

# ---- Android app (gradle property or env; consumed by app/build.gradle.kts) ----
BACKEND_BASE_URL=http://192.168.0.104:8080/

# ---- Release signing (deploy-play.yml secrets; locally place bank-release.jks in app/) ----
KEYSTORE_PASSWORD=changeit
KEY_ALIAS=bank-upload
KEY_PASSWORD=changeit
KEYSTORE_BASE64=

# ---- Google Play upload service account (CI secret, JSON) ----
PLAY_SERVICE_ACCOUNT_JSON=

# ---- Ktor backend (HOCON overrides in backend/src/main/resources/application.conf) ----
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/bank
DB_USER=bank
DB_PASSWORD=bank
