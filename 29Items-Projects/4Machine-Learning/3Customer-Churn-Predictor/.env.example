# =============================================================================
# Customer Churn Predictor — environment template.
# Copy to `.env` for local development and fill in real values.
# NEVER commit a populated `.env`. In Streamlit Cloud / CI use the secrets store.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
RANDOM_SEED=42

# --- Database (SQLAlchemy URL) ---------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://churn:churn@localhost:5432/churn
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Model -----------------------------------------------------------------
MODEL_ARTIFACT_PATH=models/artifacts/model.joblib
# Optional: remote location to pull the artifact from on first load (S3/HTTPS).
MODEL_REMOTE_URL=

# --- Hyperparameter tuning (Optuna) ----------------------------------------
OPTUNA_N_TRIALS=50
OPTUNA_TIMEOUT_SEC=900
CV_FOLDS=5

# --- App auth (optional) ---------------------------------------------------
# When set, the Streamlit app requires this shared password. Leave empty to
# disable (e.g. when relying on Streamlit Cloud SSO / a reverse proxy).
APP_PASSWORD=
