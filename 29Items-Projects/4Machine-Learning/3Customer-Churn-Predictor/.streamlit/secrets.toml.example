# Streamlit secrets template.
# In Streamlit Community Cloud, paste these into the app's "Secrets" UI.
# Locally, copy to `.streamlit/secrets.toml` (git-ignored) for `st.secrets`.

DATABASE_URL = "postgresql+psycopg://user:password@host:5432/churn"
MODEL_REMOTE_URL = ""

# Optional shared-password gate for the app (if not using Cloud SSO).
APP_PASSWORD = "change-me"
