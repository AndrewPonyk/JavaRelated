# Root environment template — copy to .env and fill in. Per-service templates live in
# backend/.env.example and frontend/.env.example. NEVER commit a real .env.
#
# Out of the box the app runs on the `local` backend (no cloud creds needed). Switch the
# three *_BACKEND/MODE vars to the cloud values to use Claude on Bedrock + Pinecone + S3.

# ─── App ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ─── Backend selection ─────────────────────────────────
RAG_BACKEND=local           # local | bedrock
STORAGE_BACKEND=local       # local | s3
INGEST_MODE=inline          # inline | queue
LOCAL_STORAGE_DIR=./.data/documents

# ─── AWS / Bedrock (RAG_BACKEND=bedrock) ───────────────
# Bedrock model IDs carry the `anthropic.` prefix (NOT the bare first-party ID).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8
BEDROCK_MODEL_ID_FAST=anthropic.claude-haiku-4-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Local dev only — in AWS use an IAM role (IRSA / task role), not static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=docintel-documents
SQS_QUEUE_URL=

# ─── Pinecone (RAG_BACKEND=bedrock) ────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=doc-intelligence
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIMENSION=1024

# ─── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docintel

# ─── LangSmith (observability) ─────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doc-intelligence

# ─── Auth ──────────────────────────────────────────────
# Production: set JWT_JWKS_URL to verify RS256 tokens. Empty → dev-token mode.
JWT_ISSUER=
JWT_AUDIENCE=doc-intelligence-api
JWT_JWKS_URL=
JWT_DEV_SECRET=dev-secret-change-me

# ─── RAG tuning ────────────────────────────────────────
RAG_TOP_K=6
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_TOKENS=4096
