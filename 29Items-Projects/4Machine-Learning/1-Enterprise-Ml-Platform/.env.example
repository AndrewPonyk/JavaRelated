# ---------------------------------------------------------------------------
# Enterprise ML Platform — environment template.
# Copy to `.env` for local dev (git-ignored). Real secrets in staging/prod come
# from AWS Secrets Manager / SSM, NOT this file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=dev                 # dev | staging | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_PORT=8000

# --- Database ---------------------------------------------------------------
# Dev default: SQLite (zero infra, survives restart). For prod/compose use:
#   DATABASE_URL=postgresql+asyncpg://mluser:changeme@localhost:5432/mlplatform
DATABASE_URL=sqlite+aiosqlite:///./mlplatform.db

# --- MLflow -----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_ARTIFACT_BUCKET=s3://enterprise-ml-artifacts

# --- AWS / SageMaker --------------------------------------------------------
AWS_REGION=us-east-1
SAGEMAKER_EXECUTION_ROLE_ARN=
SAGEMAKER_DEFAULT_INSTANCE_TYPE=ml.m5.large

# --- Cache / online features ------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth -------------------------------------------------------------------
# AUTH_MODE: hs256 (shared-secret service tokens) | oidc (RS256/JWKS) | disabled
# 'disabled' is rejected at startup when APP_ENV=prod.
AUTH_MODE=hs256
# Required for hs256. Use a strong random value; in prod inject from Secrets
# Manager. Leave blank in dev to use a clearly-insecure built-in dev key.
JWT_SECRET=
OIDC_ISSUER=https://example.auth.us-east-1.amazoncognito.com
OIDC_AUDIENCE=enterprise-ml-platform
JWT_ALGORITHMS=["RS256"]

# --- API behavior -----------------------------------------------------------
# JSON array of allowed CORS origins. Wildcard is rejected in prod.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# --- Frontend (Vite, build-time) --------------------------------------------
VITE_API_BASE_URL=/api
