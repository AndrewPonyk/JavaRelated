# Copy to .env for local development. NEVER commit a real .env.

# --- App ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
PORT=8080

# --- Model ---
MODEL_VERSION=v1
MODEL_PATH=/models/vit_clip_v1.onnx
LABELS_PATH=/models/labels.json
THRESHOLDS_PATH=/models/thresholds.json
MAX_UPLOAD_BYTES=10485760      # 10 MiB

# --- Redis (optional; cache degrades gracefully if unset/unreachable) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# --- Database (taxonomy). Use sqlite:// for a quick local run. ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ics

# --- Security ---
API_KEYS=devkey1,devkey2       # comma-separated; compared in constant time
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=3600
CONSOLE_USERNAME=admin         # demo console login for POST /auth/token
CONSOLE_PASSWORD=admin

# --- Rate limiting (per API key / IP, per instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SEC=2.0
