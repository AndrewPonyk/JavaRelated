# .env.example
# Copy this file to .env and fill in the values for local development.
# DO NOT commit the actual .env file to version control.

# React App Configuration
REACT_APP_API_BASE_URL=http://localhost:5162/api
REACT_APP_SIGNALR_HUB_URL=http://localhost:5162/hubs/notifications

# Backend Database Configurations (used by Docker Compose)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=InsuranceDb;User Id=sa;Password=YourStrong!Password;TrustServerCertificate=True;
SQL_SERVER_SA_PASSWORD=YourStrong!Password
SQL_SERVER_PORT=1433

# Kafka Configurations
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PREFIX=dev_insurance_

# IdentityServer & Auth
AUTH_SECRET_KEY=super_secret_key_change_in_production
OIDC_CLIENT_ID=react_spa
OIDC_AUTHORITY=https://localhost:5001

# Hangfire
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASS=admin
