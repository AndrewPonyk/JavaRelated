# ── Enterprise Insurance Portal — local development template ─────────────
# Copy to `.env` (gitignored) next to docker-compose usage. Real environments get
# configuration from Azure Key Vault via the AKS CSI Secrets Store driver — never
# from committed files. Defaults below match appsettings.json out of the box.

# SQL Server (docker-compose)
SQLSERVER_SA_PASSWORD=ChangeMe_Local0nly!
POLICY_DB_CONNECTION=Server=localhost,1433;Database=InsurancePortal;User Id=sa;Password=ChangeMe_Local0nly!;TrustServerCertificate=true

# Kafka (empty disables Kafka: events stay in the outbox and are logged)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_POLICY_EVENTS_TOPIC=policy-events

# Service addresses (dotnet run defaults — see Properties/launchSettings.json)
POLICY_API_BASEURL=http://localhost:5101
RATING_GRPC_ADDRESS=http://localhost:5201

# OIDC (empty = header-driven Dev auth scheme for local development)
IDENTITY_AUTHORITY=

# Azure SignalR (empty = in-process SignalR, fine for a single Blazor instance)
AZURE_SIGNALR_CONNECTIONSTRING=

# Hangfire reports output
REPORTS_OUTPUT_PATH=reports

# React portal (Vite)
VITE_API_BASE_URL=http://localhost:5101

# API rate limit per caller (requests per second)
RATELIMITING_PERMITPERSECOND=100
