<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage collection settings: dotnet test - -settings coverlet.runsettings
     Excludes protobuf/compiler-generated code, EF migrations, and composition roots
     so the numbers reflect hand-written logic. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs,**/Program.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
