# Log Analytics Platform — environment template
# Copy to `.env` for local development. All settings are typed & documented in
# src/log_analytics/common/config.py (pydantic-settings, prefix LA_).
# NEVER commit a real .env. In AWS these come from SSM/Secrets Manager (see TECH-NOTES 3.4).

# ── Core ─────────────────────────────────────────────
LA_APP_ENV=dev                       # dev | staging | prod
LA_LOG_LEVEL=INFO

# ── Kafka ────────────────────────────────────────────
LA_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
LA_KAFKA_CLIENT_ID=log-analytics
# MSK: SASL_SSL + SCRAM-SHA-512 (leave PLAINTEXT locally)
LA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
LA_KAFKA_SASL_MECHANISM=
LA_KAFKA_SASL_USERNAME=
LA_KAFKA_SASL_PASSWORD=

# ── OpenSearch / Elasticsearch ───────────────────────
LA_OPENSEARCH_URL=http://localhost:9200
LA_OPENSEARCH_USERNAME=              # empty for local (security plugin disabled)
LA_OPENSEARCH_PASSWORD=

# ── Ingestion gateway ────────────────────────────────
LA_GATEWAY_API_KEYS=                 # comma-separated keys; EMPTY DISABLES AUTH (dev only!)
LA_GATEWAY_MAX_BATCH=1000            # max events per POST /v1/logs
LA_GATEWAY_RATE_LIMIT_RPS=0          # sustained events/sec per caller; 0 disables
LA_GATEWAY_RATE_LIMIT_BURST=5000     # token-bucket capacity (events)

# ── Alerting ─────────────────────────────────────────
LA_REDIS_URL=redis://localhost:6379/0
LA_SLACK_WEBHOOK_URL=                # https://hooks.slack.com/services/… (secret!)
LA_PAGERDUTY_ROUTING_KEY=            # Events API v2 routing key (secret!)
LA_ANOMALY_ALERT_THRESHOLD=0.8       # fallback when no anomaly_score rules configured
LA_ANOMALY_CRITICAL_THRESHOLD=0.95
LA_ALERT_DEDUP_TTL_SECONDS=300       # suppress identical alerts within this window
LA_RULES_PATH=config/alert_rules.yaml
LA_SILENT_SERVICE_CHECK_SECONDS=60   # "service went silent" check interval; 0 disables
LA_SILENT_SERVICE_AFTER_MINUTES=10

# ── ML / Spark ───────────────────────────────────────
LA_MODEL_REGISTRY_URI=./models       # local dir, or s3://bucket/prefix in AWS
LA_SPARK_CHECKPOINT_DIR=./.checkpoints
LA_MODEL_REFRESH_SECONDS=300         # scoring job re-checks the registry latest pointer
LA_ANOMALY_MIN_EVENTS=10             # skip windows with fewer events (no shape = noise)

# ── Query/Admin API ──────────────────────────────────
LA_RULES_BACKEND=auto                # opensearch | memory | auto (probe + fallback)
LA_CORS_ORIGINS=                     # comma-separated origins; empty disables CORS
