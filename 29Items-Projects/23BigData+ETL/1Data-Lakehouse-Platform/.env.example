# =============================================================================
# Data Lakehouse Platform — environment template
# Copy to `.env` for local development. Never commit real secrets.
# Defaults below match docker-compose.yml. In AWS these come from
# Secrets Manager / task definitions, not from a file.
# =============================================================================

# --- AWS / object storage (local values point at MinIO) ---------------------
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Lake layer base URIs (s3a:// locally / OSS Spark; s3:// on EMR)
LAKE_BRONZE_URI=s3a://lakehouse-bronze
LAKE_SILVER_URI=s3a://lakehouse-silver
LAKE_GOLD_URI=s3a://lakehouse-gold
LAKE_ARTIFACTS_URI=s3a://lakehouse-artifacts

# --- Kafka -------------------------------------------------------------------
# host access (compose EXTERNAL listener); inside the compose network use kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ORDERS_TOPIC=orders.v1
KAFKA_DLQ_TOPIC=orders.v1.dlq
# MSK hardening (unset locally): SASL_SSL + AWS_MSK_IAM + the IAM jaas config
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_MAX_OFFSETS_PER_TRIGGER=
KAFKA_FAIL_ON_DATA_LOSS=false

# --- Governance catalog registration (Spark jobs → API) -----------------------
CATALOG_API_URL=http://localhost:8000
CATALOG_API_TOKEN=
CATALOG_DEFAULT_OWNER=data-platform@example.com

# --- Catalog metadata DB (Postgres) ------------------------------------------
DATABASE_URL=postgresql+psycopg://lakehouse:lakehouse@localhost:5432/catalog

# --- Catalog API --------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Empty AUTH_JWKS_URL = development mode (anonymous platform-admin).
# Point at your IdP's JWKS to enforce JWT auth, e.g.
#   https://cognito-idp.eu-central-1.amazonaws.com/<pool>/.well-known/jwks.json
AUTH_JWKS_URL=
AUTH_AUDIENCE=lakehouse-console
AUTH_ROLES_CLAIM=roles
# Audit fan-out to Kafka (DB row remains the source of truth)
KAFKA_AUDIT_ENABLED=false
KAFKA_AUDIT_TOPIC=platform.audit.v1

# --- Trino --------------------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8081
TRINO_USER=catalog-api
TRINO_CATALOG=delta
TRINO_HTTP_SCHEME=http
PREVIEW_ROW_LIMIT=100

# --- Spark --------------------------------------------------------------------
SPARK_MASTER=local[*]
LAKEHOUSE_LOCAL=1               # 1 = wire Delta + MinIO via pip-installed jars

# --- Frontend (Vite reads only VITE_* vars) -----------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Airflow (local standalone) ------------------------------------------------
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Set these on MWAA to submit Spark jobs to EMR Serverless instead of Bash:
LAKEHOUSE_EMR_APPLICATION_ID=
LAKEHOUSE_EMR_JOB_ROLE_ARN=
LAKEHOUSE_ARTIFACTS_BUCKET=lakehouse-artifacts
LAKEHOUSE_WHEEL_VERSION=latest
LAKEHOUSE_DBT_DIR=/opt/airflow/dbt
