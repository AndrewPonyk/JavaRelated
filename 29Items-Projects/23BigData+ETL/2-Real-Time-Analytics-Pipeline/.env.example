# Real-Time Analytics Pipeline — local configuration template.
# Copy to `.env` (git-ignored) and adjust. AWS environments do NOT use .env:
# config comes from SSM Parameter Store / Secrets Manager (see docs/TECH-NOTES.md §3.4).

# ─── Kafka ────────────────────────────────────────────────
# Host clients (seed script, locally-run API). Inside the compose network use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics_local_pw   # local only — never a real secret here

# ─── Elasticsearch ────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Analytics API ────────────────────────────────────────
API_PORT=8080
FLYWAY_ENABLED=true
MIGRATIONS_DIR=../../migrations
ES_QUERIES_ENABLED=true        # false → API serves aggregate queries from PostgreSQL only
ES_HOT_WINDOW=PT24H            # ranges ending inside this window hit Elasticsearch first
KAFKA_LISTENERS_ENABLED=true   # false → API runs without a broker (no SSE pushes / alert ingest)

# ─── Frontend ─────────────────────────────────────────────
# Leave VITE_API_BASE_URL unset for local dev — the SPA talks same-origin through
# the Vite proxy (target: RTAP_PROXY_TARGET, default http://localhost:8080).
# Set it only for standalone production builds that bypass a routing layer.
#VITE_API_BASE_URL=

# ─── Grafana (local instance) ─────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_local_pw

# ─── AWS (deploy tooling only, not the app) ───────────────
AWS_REGION=eu-central-1
# TODO: set after `terraform apply` bootstrap of the artifacts bucket
ARTIFACTS_BUCKET=rtap-dev-artifacts
